<div class="likes-screen-wrapper">
  
  <%# --- 1. HEADER --- %>
  <div class="likes-header">
    <div class="header-left">
      <%= image_tag "texto-curtidas.png", class: "header-title-img", alt: "Curtidas" %>
    </div>
    <div class="header-right">
      <div class="icons-pill">
        <button class="icon-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L4 5V11.09C4 16.14 7.41 20.85 12 22C16.59 20.85 20 16.14 20 11.09V5L12 2ZM12 11.99H12.01V12H12V11.99ZM13 16H11V14H13V16ZM13 12H11V8H13V12Z" fill="#e0e0e0"/></svg>
        </button>
        <button class="icon-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="2" fill="#e0e0e0"/><circle cx="19" cy="12" r="2" fill="#e0e0e0"/><circle cx="5" cy="12" r="2" fill="#e0e0e0"/></svg>
        </button>
      </div>
    </div>
  </div>

  <%# --- 2. ABAS (TABS) COM JAVASCRIPT --- %>
  <div class="likes-tabs">
    <div class="tab active" id="tab-received" onclick="switchTab('received')">
      <span class="tab-count"><%= @notifications.count %> curtidas</span>
    </div>
    
    <div class="tab inactive" id="tab-sent" onclick="switchTab('sent')">
      <span>Você curtiu</span>
    </div>
  </div>

  <%# --- 3. SUBTÍTULO DINÂMICO --- %>
  <div class="likes-subheader">
    <h3 id="subheader-text">Quem te curtiu</h3>
  </div>

  <%# ========================================================= %>
  <%# CONTEÚDO 1: QUEM TE CURTIU (Padrão) %>
  <%# ========================================================= %>
  <div id="grid-received" class="likes-content-area">
    <% if @notifications.any? %>
      <div class="likes-grid">
        <% @notifications.each do |notification| %>
          <%# Reutiliza o card que já criamos %>
          <%= render 'notification', notification: notification %>
        <% end %>
      </div>
    <% else %>
      <div class="likes-empty">
        <div class="empty-icon-gold">💛</div>
        <p>Ninguém te curtiu recentemente.</p>
      </div>
    <% end %>
  </div>

<%# ========================================================= %>
  <%# CONTEÚDO 2: QUEM VOCÊ CURTIU (Inicialmente Oculto) %>
  <%# ========================================================= %>
  <div id="grid-sent" class="likes-content-area" style="display: none;">
    <% if @my_likes.any? %>
      <div class="likes-grid">
        <% @my_likes.each do |like| %>
          
          <%# CORREÇÃO DEFINITIVA: Usando a associação correta 'like.liked' %>
          <% target_user = like.liked %>
          
          <% if target_user %>
            <div class="like-card">
              <%= link_to user_path(target_user), class: "like-card-link" do %>
                <%# Foto %>
                <% if target_user.avatar.attached? %>
                  <%= image_tag target_user.avatar, class: "like-card-img" %>
                <% else %>
                  <%= image_tag "default-avatar.png", class: "like-card-img" %>
                <% end %>

                <div class="like-card-gradient"></div>

                <div class="like-card-info">
                  <div class="user-details">
                    <%# Nome e Idade %>
                    <span class="name"><%= target_user.display_name.split.first %></span>
                    <span class="age"><%= target_user.age rescue "" %></span>
                  </div>
                  <div class="distance-info">
                    <%# Tempo relativo %>
                    Enviado <%= time_ago_in_words(like.created_at) %> atrás
                  </div>
                </div>
              <% end %>
            </div>
          <% end %> <%# Fim do if target_user %>

        <% end %> <%# Fim do loop %>
      </div>
    <% else %>
      <%# Estado Vazio %>
      <div class="likes-empty">
        <div class="empty-icon-gold">👀</div>
        <p>Você ainda não curtiu ninguém.</p>
      </div>
    <% end %>
  </div>

</div>

<%# --- SCRIPT PARA TROCA DE ABAS --- %>
<script>
  function switchTab(tabName) {
    // 1. Elementos
    const tabReceived = document.getElementById('tab-received');
    const tabSent = document.getElementById('tab-sent');
    const gridReceived = document.getElementById('grid-received');
    const gridSent = document.getElementById('grid-sent');
    const subheader = document.getElementById('subheader-text');

    // 2. Lógica de Troca
    if (tabName === 'sent') {
      // Ativar aba Enviados
      tabSent.classList.add('active');
      tabSent.classList.remove('inactive');
      tabReceived.classList.remove('active');
      tabReceived.classList.add('inactive');

      // Mostrar Grid Enviados
      gridReceived.style.display = 'none';
      gridSent.style.display = 'block';
      
      // Mudar Texto
      subheader.innerText = "Pessoas que você curtiu";

    } else {
      // Ativar aba Recebidos
      tabReceived.classList.add('active');
      tabReceived.classList.remove('inactive');
      tabSent.classList.remove('active');
      tabSent.classList.add('inactive');

      // Mostrar Grid Recebidos
      gridSent.style.display = 'none';
      gridReceived.style.display = 'block';

      // Mudar Texto
      subheader.innerText = "Quem te curtiu";
    }
  }
</script>