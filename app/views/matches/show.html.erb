<div class="chat-screen-wrapper" style="overflow-x: hidden; width: 100%; max-width: 100vw;">
  
  <%# --- 1. HEADER MINIMALISTA (Fixo no topo) --- %>
  <div class="chat-header-dark">
    <%= link_to matches_path, class: "back-btn" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>

    <% @other_user = @match.other_user(current_user) %>
    
    <div class="header-user-info">
      <%= link_to user_path(@other_user), class: "header-avatar-link" do %>
        <% if @other_user.avatar.attached? %>
          <%= image_tag @other_user.avatar, class: "header-avatar" %>
        <% else %>
          <div class="header-avatar-placeholder"><%= @other_user.display_name[0] %></div>
        <% end %>
      <% end %>

      <div class="header-text">
        <h2 class="header-name" style="display: flex; align-items: center; gap: 5px;">
          <%= @other_user.display_name %>
          <% if @other_user&.verified? %>
            <%= image_tag "icone-verificar.png", style: "width: 18px; height: 18px; flex-shrink: 0;", title: "Perfil Verificado" %>
          <% end %>
        </h2>
        <span class="header-status">
          <% if @other_user.respond_to?(:online?) && @other_user.online? %>
            <span class="dot-online">●</span> Online
          <% else %>
            <span class="dot-offline">●</span> Offline
          <% end %>
        </span>
      </div>
    </div>

    <div class="header-actions">
      <div class="dropdown-wrapper">
        <button class="icon-btn-dots" id="chat-options-btn">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#666"><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="12" r="2"/></svg>
        </button>

       <div class="chat-dropdown-menu hidden" id="chat-options-menu">
  
  <%# --- 1. LIMPAR CONVERSA --- %>
  <%= button_to clear_conversation_match_path(@match), 
      method: :delete, 
      id: "clear-chat-btn", # ADICIONE ESTE ID
      class: "dropdown-item warning", 
      data: { confirm: "Tem certeza que deseja apagar todas as mensagens?" } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
    Limpar conversa
  <% end %>

  <%# --- 2. DENUNCIAR (NOVO) --- %>
  <%# Usamos method: :get para navegar para a página de denúncia %>
  <%# Sugestão: Você pode querer passar o ID do usuário na URL: report_incident_path(user_id: @other_user.id) %>
  <%= button_to report_incident_path, 
      method: :get, 
      class: "dropdown-item" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
    Denunciar
  <% end %>

  <%# --- 3. BLOQUEAR USUÁRIO --- %>
  <%= button_to block_user_path(@other_user), 
      method: :post, 
      class: "dropdown-item danger", 
      data: { confirm: "Bloquear este usuário? Vocês não verão mais o perfil um do outro." } do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
    Bloquear usuário
  <% end %>
  
</div>
      </div> 
    </div> 
  </div> 

  <%# --- 2. ÁREA DE MENSAGENS --- %>
  <div id="chat-window" class="chat-window-dark"
       data-match-id="<%= @match.id %>"
       data-current-user-id="<%= current_user.id %>">

  <div class="messages-slide-container">

   <%# Aviso de Match (Topo) %>
    <div class="match-date-notice">
      <%# Verifica se é um Match Mútuo %>
      <% is_mutual = current_user.likes.exists?(liked_id: @other_user.id) && @other_user.likes.exists?(liked_id: current_user.id) %>

      <% if is_mutual %>
        VOCÊ DEU MATCH COM <%= @other_user.display_name.upcase %> NO DIA <%= @match.created_at.strftime("%d/%m/%Y") %>
      <% else %>
        VOCÊ INICIOU A CONVERSA COM <%= @other_user.display_name.upcase %> NO DIA <%= @match.created_at.strftime("%d/%m/%Y") %>
      <% end %>
    </div>

    <%# Loop de Mensagens %>
    <% last_date = nil %>
    <% @messages.each do |message| %>

      <%# Separador de Data %>
      <% msg_date = message.created_at.to_date %>
      <% if last_date != msg_date %>
        <div class="date-separator">
          <%= l(msg_date, format: :long) rescue msg_date.strftime("%d de %b") %>
        </div>
        <% last_date = msg_date %>
      <% end %>

      <div id="msg-<%= message.id %>"
           data-sending="false"
           data-content="<%= message.content %>"
           class="message message-row <%= message.sender_id == current_user.id ? 'sent' : 'received' %>">

        <%# Avatar (apenas nas recebidas) %>
        <% unless message.sender_id == current_user.id %>
          <div class="msg-avatar-container">
            <% if message.sender&.avatar&.attached? %>
              <%= image_tag message.sender.avatar, class: "msg-avatar" %>
            <% else %>
              <div class="msg-avatar-placeholder"><%= message.sender&.display_name.to_s[0] || "?" %></div>
            <% end %>
          </div>
        <% end %>

       <div class="message-bubble">
        <%= message.content %>
       </div>
       <% if message.sender_id == current_user.id %>
         <div class="message-status status-<%= message.status %>" data-status-id="<%= message.id %>"></div>
       <% end %>
       <span class="message-timestamp"><%= message.created_at.strftime("%H:%M") %></span>
      </div>
    <% end %>

    <%# --- INDICADOR DE DIGITAÇÃO (INSERIDO AQUI) --- %>
    <div id="typing-indicator" style="display: none; padding: 10px 20px; font-size: 0.8rem; color: #888;">
      <%# O JS vai injetar: "Fulano está digitando..." aqui %>
    </div>

  </div><%# /messages-slide-container %>

  </div>

  <%# --- 3. INPUT (Barra inferior) --- %>
  <div class="chat-input-dark">
    <%# Botão GIF (Decorativo) %>
    <button class="btn-gif">GIF</button>

    <%= form_with url: match_messages_path(@match), 
                  method: :post, 
                  id: "new-message-form", 
                  class: "dark-form",
                  data: { remote: true } do |form| %>
      
      <%= form.text_field :content, id: "message-input", 
            placeholder: "Digite uma mensagem", 
            autocomplete: "off",
            class: "dark-input" %>
      
      <button type="submit" id="send-button" class="btn-send">
          ➤
      </button>
    <% end %>
  </div>

</div>

<%= javascript_include_tag "chat_logic", type: "module" %>