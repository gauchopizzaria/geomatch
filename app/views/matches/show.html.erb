<%# Conversa — layout do mockup (fonte Inter). Estilos em chat.scss e chat_media.scss
    (áudio, foto, gravador e painel do "+"); envio, toque longo (menu da mensagem), editar,
    apagar e "digitando" em chat_logic.js; gravação e player em app/javascript/chat/. %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<% end %>

<% online_label = online_now_label(@other_user) %>

<div class="chat-screen-wrapper">

  <%# --- 1. TOPO --- %>
  <div class="chat-header-dark">
    <%= link_to matches_path, class: "back-btn", aria: { label: "Voltar" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    <% end %>

    <%= link_to user_path(@other_user), class: "header-user-info" do %>
      <span class="header-avatar-wrap">
        <%= image_tag @other_user.avatar_url, class: "header-avatar", alt: "" %>
        <% if online_label %><span class="header-online" aria-hidden="true"></span><% end %>
      </span>
      <span class="header-text">
        <span class="header-name">
          <span class="header-name-text"><%= @other_user.display_name %></span>
          <% if @other_user.verified? %>
            <svg class="header-verified" viewBox="0 0 24 24" aria-label="Perfil verificado"><circle cx="12" cy="12" r="11"/><path d="M7 12.5l3.2 3.2L17 9"/></svg>
          <% end %>
        </span>
        <span class="header-status <%= 'is-online' if online_label %>"><%= chat_status_label(@other_user) %></span>
      </span>
    <% end %>

    <div class="header-actions">
      <div class="gm-header-trigger" data-controller="chat-menu">
        <button type="button" class="gm-icon-btn"
                data-action="click->chat-menu#toggle"
                data-chat-menu-target="trigger"
                aria-label="Mais opções"
                aria-haspopup="menu"
                aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></svg>
        </button>
        <%= render "matches/chat_menu", match: @match, other_user: @other_user %>
      </div>
    </div>
  </div>

  <%# --- 2. MENSAGENS --- %>
  <div id="chat-window" class="chat-window-dark"
       data-match-id="<%= @match.id %>"
       data-read-url="<%= read_match_path(@match) %>"
       data-current-user-id="<%= current_user.id %>"
       data-other-user-name="<%= @other_user.display_name %>"
       data-edit-window="<%= Message::EDIT_WINDOW.to_i %>"
       data-delete-window="<%= Message::DELETE_FOR_EVERYONE_WINDOW.to_i %>"
       data-chat-controls="<%= Message.chat_controls? %>"
       data-connection-date="<%= @match.created_at.iso8601 %>">

    <div class="messages-slide-container">

      <%# Aviso de segurança (sempre no começo da conversa) %>
      <div class="chat-safety-tip">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <p>Para o primeiro encontro, prefira um lugar público. Nunca envie dinheiro para quem você conheceu no app.</p>
      </div>

      <%# Como a conexão começou, no dia em que aconteceu %>
      <% last_date = @match.created_at.to_date %>
      <div class="date-separator is-connection"><%= chat_day_label(last_date) %></div>
      <div class="chat-connection-chip">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= connection_chip_text(@match, current_user) %>
      </div>

      <% @messages.each_with_index do |message, index| %>
        <% msg_date = message.created_at.to_date %>
        <% if msg_date != last_date %>
          <div class="date-separator"><%= chat_day_label(msg_date) %></div>
          <% last_date = msg_date %>
        <% end %>

        <%
          mine = message.sender_id == current_user.id
          nxt  = @messages[index + 1]
          # Horário só embaixo do último balão de cada sequência da mesma pessoa
          group_end = nxt.nil? || nxt.sender_id != message.sender_id ||
                      nxt.created_at.to_date != msg_date || nxt.created_at - message.created_at > 5.minutes
          reactions = message.reactions.group_by(&:emoji).transform_values(&:size)
        %>
        <div id="msg-<%= message.id %>"
             data-sending="false"
             data-kind="<%= message.kind %>"
             data-content="<%= message.content %>"
             data-sent-at="<%= message.created_at.iso8601 %>"
             data-status="<%= message.status %>"
             data-read-at="<%= message.read_at&.iso8601 %>"
             class="message message-row <%= mine ? 'sent' : 'received' %> <%= 'is-group-end' if group_end %>">

          <% gift = message.mimo_gift? %>
          <div class="message-bubble <%= "is-#{message.kind}" if message.media? || gift %>">
            <%# Resposta a uma pergunta do perfil: a pergunta e a resposta citadas %>
            <% if message.prompt_reply? %>
              <span class="msg-prompt">
                <span class="msg-prompt-label"><%= mine ? "Você respondeu a pergunta" : "Respondeu sua pergunta" %></span>
                <span class="msg-prompt-question"><%= message.prompt_question %></span>
                <span class="msg-prompt-answer"><%= message.prompt_answer %></span>
              </span>
            <% end %>
            <%# Citação da mensagem respondida — tocar nela leva até a original %>
            <% if (quoted = message.reply_to) %>
              <button type="button" class="msg-quote" data-reply-to-id="<%= quoted.id %>">
                <span class="msg-quote-name"><%= quoted.sender_id == current_user.id ? "Você" : quoted.sender&.display_name %></span>
                <span class="msg-quote-text"><%= quoted.content.to_s.truncate(Message::REPLY_PREVIEW_LENGTH) %></span>
              </button>
            <% end %>
            <%# Agradecimento de um mimo: o mimo citado em cima do texto %>
            <% if message.mimo_thanks? %>
              <%= chat_mimo_quote_tag(message, mine) %>
            <% end %>
            <%# Mimo, voz e foto: o content é só o rótulo (lista, push, citação) %>
            <% if gift %>
              <%= chat_mimo_gift_tag(message, mine) %>
            <% elsif message.audio? %>
              <%= chat_audio_tag(message) %>
            <% elsif message.photo? %>
              <%= chat_photo_tag(message) %>
            <% else %>
              <span class="msg-text"><%= message.content %></span>
            <% end %>
          </div>

          <% if reactions.any? %>
            <div class="reaction-bar">
              <% reactions.each do |emoji, count| %>
                <span class="reaction-badge"><%= emoji %><%= " #{count}" if count > 1 %></span>
              <% end %>
            </div>
          <% end %>

          <div class="message-meta">
            <span class="message-time"><%= message.created_at.strftime("%H:%M") %></span>
            <% if message.edited? %><span class="message-edited">editada</span><% end %>
            <% if mine %>
              <span class="message-status status-<%= message.status %>" data-status-id="<%= message.id %>"></span>
            <% end %>
          </div>

          <%# Horário de cada balão, revelado ao deslizar a conversa para a esquerda %>
          <span class="message-timestamp"><%= message.created_at.strftime("%H:%M") %></span>
        </div>
      <% end %>

      <%# "Digitando…": três pontinhos num balão (chat_logic.js mostra e esconde) %>
      <div id="typing-indicator" class="typing-bubble" hidden aria-label="Digitando">
        <span></span><span></span><span></span>
      </div>

    </div><%# /messages-slide-container %>
  </div>

  <%# --- 2.5. RESPONDENDO A… / EDITANDO (barra acima do campo) --- %>
  <div class="reply-preview" id="reply-preview" hidden>
    <div class="reply-preview-content">
      <span class="reply-preview-name" id="reply-preview-name"></span>
      <span class="reply-preview-text" id="reply-preview-text"></span>
    </div>
    <button type="button" class="reply-preview-close" id="reply-preview-close" aria-label="Cancelar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <%# --- RESPOSTAS RÁPIDAS (tocar preenche o campo) — só até a pessoa mandar a
      primeira mensagem nesta conversa; o chat_logic.js tira ao enviar --- %>
  <% if @show_quick_replies %>
    <div class="chat-quick-replies" id="chat-quick-replies">
      <% MatchesHelper::QUICK_REPLIES.each do |text| %>
        <button type="button" class="chat-quick-reply" data-text="<%= text %>"><%= text %></button>
      <% end %>
    </div>
  <% end %>

  <%# --- 3. CAMPO (Barra inferior) --- %>
  <%# <div> em vez de <form>: o envio é feito via JS (chat_logic.js). Isso NÃO remove
      a barra de formulário do iOS (^ v ✓) — ela é nativa e é escondida no app iOS
      (ApplicationWebViewController#hideFormAccessoryBar). %>
  <div class="chat-composer" id="chat-composer"
       data-max-duration="<%= MessageMedia::AUDIO_MAX_DURATION %>"
       data-min-duration="<%= MessageMedia::AUDIO_MIN_DURATION %>"
       data-peaks="<%= MessageMedia::AUDIO_PEAKS %>">

    <div class="chat-input-dark" id="chat-input-bar">
      <%# "+": abre o painel de anexos (Fotos, Câmera, Mimo) embaixo do campo %>
      <button type="button" class="chat-plus-btn" id="chat-plus-btn"
              aria-label="Anexar" aria-expanded="false" aria-controls="chat-attach">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>

      <div id="new-message-form" class="dark-form">
        <input type="text"
               id="message-input"
               placeholder="Mensagem"
               autocomplete="off"
               autocorrect="off"
               autocapitalize="sentences"
               enterkeyhint="send"
               class="dark-input">
      </div>

      <%# Campo vazio: microfone (segurar grava). Com texto: enviar. O chat_logic.js alterna. %>
      <button type="button" id="send-button" class="btn-send" aria-label="Enviar" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </button>
      <button type="button" id="mic-button" class="btn-send btn-mic" aria-label="Gravar áudio">
        <label class="haptic-tap" for="chat-haptic-switch" aria-hidden="true"></label>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/></svg>
      </button>

      <%# Gravando com o dedo no microfone: tempo + "Deslize para cancelar" no lugar do
          campo, e o cadeado em cima do microfone (deslizar para cima trava a gravação) %>
      <div class="rec-hold" id="rec-hold" hidden aria-live="polite">
        <span class="rec-dot" aria-hidden="true"></span>
        <span class="rec-time" id="rec-hold-time">0:00</span>
        <span class="rec-slide">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5 9 12l5.5 5.5"/></svg>
          Deslize para cancelar
        </span>
      </div>
      <div class="rec-lock" id="rec-lock" hidden aria-hidden="true">
        <svg class="rec-lock-icon" viewBox="0 0 24 24"><rect x="5.5" y="10.5" width="13" height="9.5" rx="2.2"/><path d="M8.5 10.5V7.2a3.5 3.5 0 0 1 6.9-.9"/></svg>
        <svg class="rec-lock-arrow" viewBox="0 0 24 24"><path d="m6.5 14.5 5.5-5.5 5.5 5.5"/></svg>
      </div>
    </div>

    <%# Gravação travada (mãos livres): tempo + onda ao vivo; apagar, pausar e enviar %>
    <div class="rec-locked" id="rec-locked" hidden>
      <div class="rec-bar">
        <span class="rec-dot" aria-hidden="true"></span>
        <span class="rec-time" id="rec-locked-time">0:00</span>
        <span class="rec-wave" id="rec-wave" aria-hidden="true"></span>
      </div>
      <div class="rec-actions">
        <button type="button" class="rec-btn rec-trash" id="rec-trash" aria-label="Apagar gravação">
          <label class="haptic-tap" for="chat-haptic-switch" aria-hidden="true"></label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9.5 7V5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v2M6.5 7l.8 11.2a2 2 0 0 0 2 1.8h5.4a2 2 0 0 0 2-1.8L17.5 7M10 11v5M14 11v5"/></svg>
        </button>
        <button type="button" class="rec-btn rec-pause" id="rec-pause" aria-label="Pausar gravação">
          <label class="haptic-tap" for="chat-haptic-switch" aria-hidden="true"></label>
          <svg class="rec-icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="7.5" y="6" width="3" height="12" rx="1"/><rect x="13.5" y="6" width="3" height="12" rx="1"/></svg>
          <svg class="rec-icon-resume" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/></svg>
        </button>
        <button type="button" class="rec-btn rec-send" id="rec-send" aria-label="Enviar áudio">
          <label class="haptic-tap" for="chat-haptic-switch" aria-hidden="true"></label>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>

    <%# Vibração no iPhone sem o handler nativo do app: os rótulos .haptic-tap (no
        microfone e nos botões da gravação) apontam para este interruptor; o toque real
        do dedo nele faz o iOS vibrar. Ver app/javascript/chat/haptics.js. %>
    <input type="checkbox" switch class="haptic-switch" id="chat-haptic-switch" tabindex="-1" aria-hidden="true">

    <%# Painel do "+": abre no lugar do teclado %>
    <div class="chat-attach" id="chat-attach" hidden>
      <span class="chat-attach-handle" aria-hidden="true"></span>

      <div class="chat-attach-grid">
        <button type="button" class="chat-attach-card" data-attach="gallery">
          <span class="chat-attach-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="3"/><circle cx="9" cy="10" r="1.7"/><path d="m5 17.5 4.5-4.3 3.2 3 2.8-2.7 4 3.8"/></svg>
          </span>
          <strong>Fotos</strong>
          <span>Da galeria</span>
        </button>
        <%# Mimo no meio, em destaque: abre o catálogo já com a pessoa da conversa %>
        <%= link_to mimo_catalog_page_path(receiver_id: @other_user.id), class: "chat-attach-card is-mimo" do %>
          <span class="chat-attach-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8h14v-8M12 8v12M12 8c-1.5-3-5-3.5-5-1.2C7 8 9.5 8 12 8zM12 8c1.5-3 5-3.5 5-1.2C17 8 14.5 8 12 8z"/></svg>
          </span>
          <strong>Mimo</strong>
          <span>Enviar presente</span>
        <% end %>
        <button type="button" class="chat-attach-card" data-attach="camera">
          <span class="chat-attach-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.3l1-1.6a1 1 0 0 1 .85-.4h4.7a1 1 0 0 1 .85.4l1 1.6h1.3A2.5 2.5 0 0 1 20 8.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5z"/><circle cx="12" cy="12.5" r="3.2"/></svg>
          </span>
          <strong>Câmera</strong>
          <span>Tirar agora</span>
        </button>
      </div>

      <p class="chat-attach-note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-3.5 7-9V6l-7-3-7 3v6c0 5.5 7 9 7 9z"/></svg>
        Só envie fotos que você se sentiria bem em mostrar
      </p>

      <input type="file" id="chat-photo-gallery" accept="image/*" hidden>
      <input type="file" id="chat-photo-camera" accept="image/*" capture="environment" hidden>
    </div>
  </div>

</div>

<%= render "matches/unmatch_confirm", match: @match, other_user: @other_user %>

<%= javascript_include_tag "chat_logic", type: "module" %>
