<div class="edit-profile-wrapper">

  <%# Formulário de upload da foto original — fora do form principal para evitar nesting inválido.
      turbo: false garante envio multipart nativo sem interferência do Turbo. %>
  <%= form_with url: upload_avatar_profile_path, method: :post, multipart: true,
                id: "avatar-upload-form", style: "display:none",
                data: { turbo: false } do |f| %>
    <%= f.file_field :avatar_original, id: "avatar_upload_field",
                     accept: "image/*",
                     class: "hidden-input",
                     onchange: "document.getElementById('avatar-upload-form').submit();" %>
  <% end %>

   <%= form_with model: @user, url: profile_path, method: :patch, multipart: true, id: "edit-profile-form" do |f| %>

    <%# --- 1. HEADER --- %>
    <div class="edit-header">
      <%# Botão Cancelar (Menor e mais cinza) %>
      <%= link_to my_profile_path, class: "header-btn-left" do %>
        <span>Cancelar</span>
      <% end %>

      <%# Título Imagem (Menor) %>
      <div class="header-title">
        <%= image_tag "texto-editar-perfil.png", class: "title-img" %>
      </div>

      <%# Botão Salvar %>
      <button type="submit" class="header-btn-right">
        <div class="check-circle">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
      </button>
    </div>

    <%# --- 2. ABAS (TABS) --- %>
    <div class="edit-tabs">
      <div class="tab active">Editar</div>
      <%= link_to "Visualizar", preview_profile_path, class: "tab inactive" %>
    </div>

    <div class="edit-scroll-content">
      
      <%# --- 3. GRADE DE FOTOS (Lógica Exata de 6 Slots) --- %>
      <div class="photos-section">
        <label class="photos-label">Adicionar fotos</label>
        
        <div class="photos-grid">

          <%# Variável para contar slots usados (Limite 6) %>
          <% slots_used = 0 %>

          <%# SLOT 1: AVATAR — label dispara o input que pertence ao #avatar-upload-form acima %>
          <div class="photo-slot filled">
            <%= image_tag @user.avatar_or_default, class: "slot-img", id: "avatar-preview" %>
            <label class="edit-badge" for="avatar_upload_field">
              <i class="fas fa-pen"></i>
            </label>
          </div>
          <% slots_used += 1 %>

          <%# SLOT 2 a N: FOTOS EXISTENTES %>
          <% @user.album_photos.each do |photo| %>
            <% break if slots_used >= 6 %>
            <div class="photo-slot filled">
              <%= image_tag photo, class: "slot-img" %>
              <%= link_to delete_album_photo_path(photo), data: { turbo_method: :delete }, class: "delete-badge" do %>
                ✕
              <% end %>
            </div>
            <% slots_used += 1 %>
          <% end %>

          <%# SLOT DE UPLOAD (Só aparece se tiver espaço sobrando) %>
          <% if slots_used < 6 %>
            <label class="photo-slot empty">
              <div class="plus-icon">+</div>
              <%= f.file_field :album_photos, multiple: true, class: "hidden-input",
                    onchange: "this.form.submit()" %>
            </label>
            <% slots_used += 1 %>
          <% end %>

          <%# SLOTS VAZIOS (Preenche o resto até dar 6) %>
          <% (slots_used...6).each do %>
             <div class="photo-slot empty-placeholder">
               <div class="plus-icon" style="opacity: 0.3;">+</div>
             </div>
          <% end %>

        </div>
      </div>

      <%# --- 4. CAMPOS DO FORMULÁRIO --- %>
      <div class="form-fields">
        
        <div class="field-group">
          <%= f.label :bio, "Bio", class: "dark-label" %>
          <%= f.text_area :bio, placeholder: "Fale um pouco sobre você", rows: 3, class: "dark-input textarea" %>
        </div>

        <div class="field-group">
          <%= f.label :gender, "Gênero", class: "dark-label" %>
          <%= f.select :gender, [["Homem", "Homem"], ["Mulher", "Mulher"], ["Não Binário", "Não Binário"]], { include_blank: "Selecione seu gênero" }, class: "dark-input" %>
        </div>

        <div class="field-group">
          <%= f.label :interested_in, "Quero conhecer", class: "dark-label" %>
          <%= f.select :interested_in,
                options_for_select([["Mulheres", "Mulher"], ["Homens", "Homem"], ["Todos", "Todos"]], current_user.interested_in),
                { include_blank: "Selecione" }, class: "dark-input" %>
        </div>

        <div data-controller="profile-location">
          <div class="field-group">
            <%= f.label :state, "Estado", class: "dark-label" %>
            <%= f.select :state,
                  options_for_select([
                    ["Selecione seu estado", ""],
                    ["Acre", "AC"], ["Alagoas", "AL"], ["Amapá", "AP"],
                    ["Amazonas", "AM"], ["Bahia", "BA"], ["Ceará", "CE"],
                    ["Distrito Federal", "DF"], ["Espírito Santo", "ES"],
                    ["Goiás", "GO"], ["Maranhão", "MA"], ["Mato Grosso", "MT"],
                    ["Mato Grosso do Sul", "MS"], ["Minas Gerais", "MG"],
                    ["Pará", "PA"], ["Paraíba", "PB"], ["Paraná", "PR"],
                    ["Pernambuco", "PE"], ["Piauí", "PI"],
                    ["Rio de Janeiro", "RJ"], ["Rio Grande do Norte", "RN"],
                    ["Rio Grande do Sul", "RS"], ["Rondônia", "RO"],
                    ["Roraima", "RR"], ["Santa Catarina", "SC"],
                    ["São Paulo", "SP"], ["Sergipe", "SE"], ["Tocantins", "TO"]
                  ], @user.state),
                  {},
                  class: "dark-input",
                  data: {
                    "profile-location-target": "state",
                    action: "change->profile-location#fetchCities"
                  } %>
          </div>

          <div class="field-group">
            <%= f.label :city, "Cidade", class: "dark-label" %>
            <%= f.text_field :city,
                  placeholder: "Digite sua cidade",
                  class: "dark-input",
                  list: "profile-cities-list",
                  autocomplete: "off",
                  data: { "profile-location-target": "city" } %>
            <datalist id="profile-cities-list"></datalist>
          </div>
        </div>

        <div class="field-group">
          <%= f.label :hobbies_list, "Hobbys", class: "dark-label" %>
          <%= f.text_field :hobbies_list, value: @user.hobbies_list.join(", "), placeholder: "Praia, Cinema, Esportes", class: "dark-input" %>
          <p class="field-hint">Separe por vírgulas</p>
        </div>

      </div>
      
      <br><br><br>
    </div>

  <% end %>
</div>

<script>
document.addEventListener("turbo:load", function() {
  document.querySelectorAll('.delete-badge').forEach(link => {
    link.addEventListener('click', function(e) {
      if (!confirm("Tem certeza que deseja apagar?")) {
        e.preventDefault();
      }
    });
  });
});
</script>