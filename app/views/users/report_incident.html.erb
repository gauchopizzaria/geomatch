<div class="report-wrapper">

  <%# --- 1. HEADER --- %>
  <div class="report-header">
    <%# Botão Voltar (Seta PNG) %>
    <%= link_to safety_center_path, class: "btn-back" do %>
      <%= image_tag "seta-esqueda-png.png", class: "icon-arrow" %>
    <% end %>

    <%# Título (Imagem PNG) %>
    <div class="header-title-container">
      <%= image_tag "texto-denuncia-rapida.png", class: "title-img-report" %>
    </div>

    <%# Ícone Escudo (Direita) %>
    <div class="header-icon-right">
      <%= image_tag "icone-central-de-seguranca.png", class: "icon-shield-gray" %>
    </div>
  </div>

  <%# --- 2. FORMULÁRIO --- %>
  <div class="report-body">
    
    <%# Seção Texto %>
    <div class="form-section">
      <label class="section-label">Faça sua denúncia</label>
      <span class="section-sublabel">Relate sua denúncia</span>
      <textarea class="report-textarea" placeholder=""></textarea>
    </div>

    <%# Seção Fotos %>
    <div class="photos-section-container">
      <div class="photos-header-box">
        <div class="camera-icon-circle">
           <%# Usando o PNG correto e adicionando uma classe para ajustar o tamanho %>
           <%= image_tag "icone-foto.png", class: "icon-camera-png" %>
        </div>
        <div class="photos-text">
          <strong>Adicionar fotos</strong>
          <span>Adicione fotos referente a denúncia</span>
        </div>
      </div>

      <div class="report-photos-grid">
        <div class="photo-placeholder-box">
          <span class="plus-sign">+</span>
        </div>
        <div class="photo-placeholder-box">
          <span class="plus-sign">+</span>
        </div>
        <div class="photo-placeholder-box">
          <span class="plus-sign">+</span>
        </div>
      </div>
    </div>

  </div>

  <%# --- 3. FOOTER (BOTÃO) --- %>
  <div class="report-footer">
    <button class="btn-submit-report">Enviar Denúncia</button>
  </div>

</div>