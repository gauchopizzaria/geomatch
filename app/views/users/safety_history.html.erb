<div class="safety-history-wrapper">

  <%# --- HEADER --- %>
  <div class="sh-header">
    <%= link_to safety_center_path, class: "sh-back-btn" do %>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    <% end %>
    <div class="sh-header-text">
      <h1 class="sh-title">Meu Histórico</h1>
      <p class="sh-subtitle">Bloqueados e denúncias enviadas</p>
    </div>
    <div class="sh-shield-icon">
      <%= image_tag "icone-central-de-seguranca.png", class: "sh-icon-shield" %>
    </div>
  </div>

  <%# ============================================================ %>
  <%# SEÇÃO 1: PERFIS BLOQUEADOS %>
  <%# ============================================================ %>
  <div class="sh-section">
    <div class="sh-section-header">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e05252" stroke-width="2">
        <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
      </svg>
      <h2 class="sh-section-title">Bloqueados</h2>
      <span class="sh-count-badge"><%= @blocked_users.count %></span>
    </div>

    <% if @blocked_users.any? %>
      <div class="sh-list">
        <% @blocked_users.each do |user| %>
          <div class="sh-card sh-card-blocked">
            <div class="sh-card-avatar">
              <%= image_tag user.avatar_url, class: "sh-avatar-img" %>
            </div>

            <div class="sh-card-info">
              <span class="sh-card-name"><%= user.display_name %></span>
              <span class="sh-card-meta">Perfil bloqueado</span>
            </div>

            <div class="sh-card-action">
              <%= button_to unblock_user_path(user),
                    method: :delete,
                    class: "sh-btn-unblock",
                    form: { data: { turbo_confirm: "Desbloquear #{user.display_name}? Vocês poderão se ver novamente." } } do %>
                Desbloquear
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="sh-empty">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="1.5">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
          <line x1="23" y1="11" x2="17" y2="11"/>
        </svg>
        <p>Nenhum perfil bloqueado.</p>
      </div>
    <% end %>
  </div>

  <%# ============================================================ %>
  <%# SEÇÃO 2: MINHAS DENÚNCIAS (somente leitura) %>
  <%# ============================================================ %>
  <div class="sh-section">
    <div class="sh-section-header">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#e0a052" stroke-width="2">
        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/>
        <line x1="4" y1="22" x2="4" y2="15"/>
      </svg>
      <h2 class="sh-section-title">Minhas Denúncias</h2>
      <span class="sh-count-badge"><%= @my_reports.count %></span>
    </div>

    <p class="sh-immutable-notice">
      As denúncias são registros permanentes e não podem ser editadas ou excluídas após o envio.
    </p>

    <% if @my_reports.any? %>
      <div class="sh-list">
        <% @my_reports.each do |report| %>
          <div class="sh-card sh-card-report">
            <div class="sh-report-top">
              <span class="sh-report-date">
                <%= report.created_at.strftime("%d/%m/%Y às %H:%M") %>
              </span>
              <span class="sh-status-badge">Em análise</span>
            </div>

            <p class="sh-report-description">
              <%= truncate(report.description, length: 120) %>
            </p>

            <% if report.photos.attached? %>
              <div class="sh-report-photos">
                <% report.photos.each do |photo| %>
                  <%= image_tag photo, class: "sh-report-thumb" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="sh-empty">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#444" stroke-width="1.5">
          <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
        </svg>
        <p>Nenhuma denúncia enviada ainda.</p>
      </div>
    <% end %>
  </div>

</div>
