<link href="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js"></script>
<script src="https://unpkg.com/@turf/turf@6/turf.min.js"></script>
<style>
  #map-3d {
    opacity: 0;
    transition: opacity 0.8s ease;
    /* Fallback: força visibilidade após 3s caso o evento JS não dispare */
    animation: mapReveal 0.8s ease 3s forwards;
  }
  #map-3d.map-loaded { opacity: 1; animation: none; }
  @keyframes mapReveal { to { opacity: 1; } }
</style>

<div id="assets-data" 
     data-frame-url="<%= image_path('aurea-dourada-mensagens.svg') %>"
     style="display: none;"></div>

<div id="current-user-data" data-invisible="<%= current_user.invisible %>"></div>

<div class="discover-fullscreen-container">

  <div id="map-3d" class="map-fullscreen"></div>

  <div class="discover-header-floating">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo-img" %>
    </div>
    <div class="header-right">
      <button id="gender-filter-toggle" class="btn-gender-icon" title="Filtrar Gênero">
        <%= image_tag "icone-generos.png", class: "icon-generos-img" %>
      </button>
    </div>
  </div>

  <div class="radar-control-floating">
    <div class="radar-badge-box">
      <%= image_tag "icone-300m.png", class: "radar-badge-img" %>
      <span id="range-value-text" class="dynamic-value-text">150m</span>
    </div>
    
    <div class="slider-track-container">
      <%= image_tag "icone-raio.png", class: "slider-track-bg" %>
      <input type="range" id="radar-range" min="1" max="300" value="150" step="1" class="range-slider-custom">
    </div>
  </div>

  <div class="map-fab-container">
    <button class="fab-button" id="fab-live-tracking" title="Seguir em Tempo Real">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
    </button>

    <button id="toggle-visibility-btn" class="fab-button fab-visibility" title="Modo Invisível">
      <svg class="eye-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg class="eye-closed hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
        <line x1="1" y1="1" x2="23" y2="23"></line>
      </svg>
    </button>

    <button class="fab-button" id="fab-center-map" title="Centralizar no meu local">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"></circle>
        <path d="M12 8v-2"></path>
        <path d="M12 18v2"></path>
        <path d="M8 12H6"></path>
        <path d="M18 12h2"></path>
      </svg>
    </button>
  </div>

  <div class="users-bottom-sheet">
    <div class="bottom-sheet-handle"><div class="handle-bar"></div></div>
    
    <div class="bottom-sheet-content">
      <div class="bottom-sheet-header">
        <div class="header-users-title">
           <%= image_tag "icone-usuarios-proximos.png", class: "icon-users-header" %>
           <%= image_tag "texto-usuarios-proximos.png", class: "text-users-header" %>
        </div>
        <span class="nearby-count" id="nearby-count">0</span>
      </div>
      
      <ul id="users-list" class="users-list-fullscreen">
        <li class="text-center loading-text">Buscando...</li>
      </ul>
    </div>
  </div>

  <%# --- POPUP DE USUÁRIO CORRIGIDO --- %>
  <div id="user-popup" class="user-popup-fullscreen hidden">
    <div class="popup-overlay"></div>
    
    <div class="popup-content-fullscreen dsc-sheet" id="draggable-popup">
      
      <div class="dsc-drag-handle-area">
        <div class="dsc-handle-bar"></div>
      </div>

      <button id="close-popup-btn" class="dsc-close-btn">
        <i class="fas fa-arrow-down"></i>
      </button>

      <%# CONTEÚDO SCROLLÁVEL %>
      <div class="dsc-scroll-content">
        
        <%# TOPO: FOTO IMERSIVA %>
        <div class="dsc-carousel-wrapper">
          <div class="dsc-main-carousel">
            <img id="popup-avatar" src="" class="dsc-carousel-img">
          </div>
          
          <div class="dsc-cover-overlay">
            <div class="dsc-cover-info">
              <h2 class="dsc-cover-name"><span id="popup-username"></span></h2>
              <p class="dsc-cover-distance">
                <i class="fas fa-location-arrow"></i> a <span id="popup-distance-val">0.0</span> km de distância
              </p>
            </div>
          </div>
        </div>

        <%# ÁREA DOS BOTÕES DE AÇÃO - SEM FAIXA BRANCA %>
        <div class="dsc-action-container">
          
          <%# 1. REJEITAR %>
          <%= button_to reject_user_path(user_id: 0), method: :post, class: "dsc-action-btn btn-reject", form: { id: "popup-reject-form", class: "dsc-action-form", "data-base-action" => reject_user_path(user_id: 0) } do %>
            <%= hidden_field_tag :source, "map" %> 
            <%= image_tag "botao-rejeitar.svg", alt: "Rejeitar" %>
          <% end %>

          <%# 2. CHAT %>
          <%= button_to start_chat_path(user_id: 0), method: :post, class: "dsc-action-btn btn-chat", form: { id: "popup-chat-form", class: "dsc-action-form", "data-base-action" => start_chat_path(user_id: 0) } do %>
            <%= image_tag "mensagem-prata.svg", alt: "Chat" %>
          <% end %>

          <%# 3. LIKE %>
          <%= button_to likes_path(user_id: 0), method: :post, class: "dsc-action-btn btn-like", form: { id: "popup-like-form", class: "dsc-action-form", "data-base-action" => likes_path(user_id: 0) } do %>
            <%= hidden_field_tag :source, "map" %>
            <div class="dsc-heart-icon-wrapper">
              <%= image_tag "coracao-chapada.png", alt: "Curtir" %>
            </div>
          <% end %>
        </div>

        <%# DETALHES DO PERFIL %>
        <div class="dsc-body-container">
          <div class="dsc-info-card">
            <h3 class="dsc-card-header">Sobre mim</h3>
            <div class="dsc-card-content-center">
              <p id="popup-bio" class="dsc-bio-text">Sem descrição.</p>
            </div>
          </div>

          <div class="dsc-info-card">
             <h3 class="dsc-card-header">Informações</h3>
             <div class="dsc-basic-list">
                <div class="dsc-basic-item">
                    <span class="dsc-basic-icon"><i class="fas fa-venus-mars"></i></span>
                    <span id="popup-gender" class="dsc-basic-text"></span>
                </div>
                <div class="dsc-basic-item">
                    <span class="dsc-basic-icon"><i class="fas fa-search"></i></span>
                    <span id="popup-interest" class="dsc-basic-text"></span>
                </div>
                <div class="dsc-basic-item">
                  <span class="dsc-basic-icon"><i class="fas fa-map-marker-alt"></i></span>
                  <span id="popup-city" class="dsc-basic-text">BA</span>
                </div>
             </div>
          </div>

          <div class="dsc-safety-area">
            <div class="dsc-safety-divider"></div>
            <button class="dsc-btn-safety">DENUNCIAR USUÁRIO</button>
            <div class="dsc-safety-separator"></div>
            <button class="dsc-btn-safety">BLOQUEAR USUÁRIO</button>
            <div class="dsc-safety-divider"></div>
          </div>
          
          <div class="dsc-bottom-spacer"></div>
        </div>
      </div>
    </div>
  </div>

  <%# Mini Card fixo — independente da rotação do mapa %>
  <div id="mini-card-overlay" style="display:none; position:fixed; bottom:260px; left:50%; transform:translateX(-50%) translateY(30px); z-index:1000; width:210px; pointer-events:auto; opacity:0; transition:opacity 0.28s ease, transform 0.28s cubic-bezier(0.34,1.56,0.64,1);">
    <div style="border-radius:20px; overflow:hidden; background:rgba(255,255,255,0.72); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); border:1px solid rgba(255,255,255,0.6); box-shadow:0 8px 32px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.8);">
      <img id="mco-avatar" src="" alt="" style="width:100%; height:150px; object-fit:cover; display:block;">
      <div style="padding:10px 14px 6px; text-align:center;">
        <p id="mco-name" style="margin:0; font-weight:700; font-size:1rem; color:#1a1a1a; letter-spacing:-0.2px;"></p>
        <p id="mco-distance" style="margin:3px 0 0; font-size:0.78rem; color:#555;"></p>
      </div>
      <button id="mco-view-btn" style="display:block; width:calc(100% - 24px); margin:0 12px 12px; padding:9px 0; background:linear-gradient(135deg,#d4be91,#b8975a); color:#1a1a1a; border:none; border-radius:10px; font-weight:700; font-size:0.82rem; cursor:pointer; letter-spacing:0.3px; box-shadow:0 3px 10px rgba(180,140,70,0.35);">Ver Perfil</button>
    </div>
  </div>

  <div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>
</div>

<%= javascript_include_tag "live_location", type: "module" %>
<%= javascript_include_tag "map_3d", type: "module" %>
