<div id="assets-data" 
     data-frame-url="<%= image_path('aurea-dourada-mensagens.svg') %>"
     style="display: none;"></div>

<div id="current-user-data" data-invisible="<%= current_user.invisible %>"></div>

<div class="discover-fullscreen-container">

  <div id="map" class="map-fullscreen"></div>

  <div class="discover-header-floating">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo-img" %>
    </div>
    <div class="header-right">
      <button id="gender-filter-toggle" class="btn-gender-icon" title="Filtrar Gênero">
        <%= image_tag "icone-generos.png", class: "icon-generos-img" %>
      </button>
    </div>
  </div>

  <div class="radar-control-floating">
    <div class="radar-badge-box">
      <%= image_tag "icone-300m.png", class: "radar-badge-img" %>
      <span id="range-value-text" class="dynamic-value-text">150m</span>
    </div>
    
    <div class="slider-track-container">
      <%= image_tag "icone-raio.png", class: "slider-track-bg" %>
      <input type="range" id="radar-range" min="1" max="300" value="150" step="1" class="range-slider-custom">
    </div>
  </div>

  <div class="map-fab-container">
    <button id="toggle-visibility-btn" class="fab-button fab-visibility" title="Modo Invisível">
      <svg class="eye-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg class="eye-closed hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
        <line x1="1" y1="1" x2="23" y2="23"></line>
      </svg>
    </button>

    <button class="fab-button" id="fab-center-map" title="Centralizar no meu local">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"></circle>
        <path d="M12 8v-2"></path>
        <path d="M12 18v2"></path>
        <path d="M8 12H6"></path>
        <path d="M18 12h2"></path>
      </svg>
    </button>
  </div>

  <div class="users-bottom-sheet">
    <div class="bottom-sheet-handle"><div class="handle-bar"></div></div>
    
    <div class="bottom-sheet-content">
      <div class="bottom-sheet-header">
        <div class="header-users-title">
           <%= image_tag "icone-usuarios-proximos.png", class: "icon-users-header" %>
           <%= image_tag "texto-usuarios-proximos.png", class: "text-users-header" %>
        </div>
        
        <span class="nearby-count" id="nearby-count">0</span>
      </div>
      
      <ul id="users-list" class="users-list-fullscreen">
        <li class="text-center loading-text">Buscando...</li>
      </ul>
    </div>
  </div>

 <div id="user-popup" class="user-popup-fullscreen hidden">
    <div class="popup-overlay"></div>
  <div class="popup-content-fullscreen" id="draggable-popup">
  
  <%# --- 1. ALÇA DE ARRASTE (Visual Indicator) --- %>
  <div class="popup-drag-handle-area">
    <div class="popup-handle-bar"></div>
  </div>

  <%# Botão Fechar (Mantido) %>
  <button id="close-popup-btn" class="close-popup-btn">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <%# --- 2. CABEÇALHO (Foto e Infos Básicas - MANTIDO COM AJUSTES) --- %>
  <div class="popup-header-section">
      <div class="popup-image-carousel">
        <img id="popup-avatar" src="" class="popup-image">
        <div class="popup-gradient-overlay"></div> <%# Novo degradê para leitura %>
      </div>
      
      <div class="popup-user-info-floating">
        <div class="user-header-compact">
          <div>
            <h3 id="popup-username"></h3>
            <p id="popup-location" class="location-text"></p>
          </div>
          <div class="distance-badge" id="popup-distance"></div>
        </div>
      </div>
  </div>

<%# --- ÁREA DOS BOTÕES DE AÇÃO --- %>
 <div class="popup-user-info" style="position: relative;">
        
        <%# --- BOTÕES DE AÇÃO (IGUAIS AO LEAD) --- %>
        <%# Coloquei margin-top negativo para eles subirem e ficarem "flutuando" entre a foto e o texto, se desejar %>
        <div class="action-buttons-container" style="display: flex; justify-content: center; gap: 20px; margin-top: -30px; margin-bottom: 15px; position: relative; z-index: 10;">
          
         <%# 1. BOTÃO REJEITAR (X) %>
          <%= button_to reject_user_path(user_id: 0), method: :post, class: "action-btn btn-reject", form: { id: "popup-reject-form", "data-base-action" => reject_user_path(user_id: 0) } do %>
            <%# --- CAMPO NOVO --- %>
            <%= hidden_field_tag :source, "map" %> 
            <%= image_tag "botao-rejeitar.svg", alt: "Rejeitar" %>
          <% end %>

          <%# 2. CHAT %>
          <%= button_to start_chat_path(user_id: 0), method: :post, class: "action-btn btn-chat", form: { id: "popup-chat-form", "data-base-action" => start_chat_path(user_id: 0) } do %>
             <%= image_tag "mensagem-prata.svg", alt: "Chat" %>
          <% end %>

         <%# 3. BOTÃO LIKE (Coração) %>
          <%= button_to likes_path(user_id: 0), method: :post, class: "action-btn btn-like", form: { id: "popup-like-form", "data-base-action" => likes_path(user_id: 0) } do %>
            <%# --- CAMPO NOVO --- %>
            <%= hidden_field_tag :source, "map" %>
            <div class="heart-icon-wrapper">
               <%= image_tag "coracao-chapada.png", alt: "Curtir" %>
            </div>
          <% end %>
        </div>

        <%# --- 4. DETALHES COMPLETOS (NOVO - APARECE AO ARRASTAR) --- %>
  <div id="popup-full-details" class="popup-details-container">
      <div class="details-scroll-content">
          
          <%# Bio Section %>
          <div class="profile-info-card">
              <h3 class="card-header">Sobre mim</h3>
              <p id="popup-bio" class="profile-bio-text">Sem descrição.</p>
          </div>

          <%# Info Grid %>
          <div class="profile-info-card">
             <h3 class="card-header">Informações</h3>
             <div class="basic-info-list">
                <div class="basic-item">
                    <span class="basic-icon">⚧</span>
                    <span id="popup-gender" class="basic-text"></span>
                </div>
                <div class="basic-item">
                    <span class="basic-icon">👀</span>
                    <span id="popup-interest" class="basic-text"></span>
                </div>
             </div>
          </div>

          <%# Tags Section %>
          <div class="profile-info-card" id="popup-tags-container" style="display:none;">
              <h3 class="card-header">Interesses</h3>
              <div class="tags-container" id="popup-tags-list"></div>
          </div>
          
          <div class="bottom-spacer" style="height: 100px;"></div>
      </div>
  </div>

        <%# --- INFORMAÇÕES DE TEXTO --- %>
        <div class="user-header" style="text-align: center; padding-top: 10px;">
          <div>
            <h3 id="popup-username" style="font-size: 1.5rem; margin-bottom: 5px;"></h3>
            <p id="popup-location" class="location-text" style="color: #888;"></p>
          </div>
          <div class="distance-badge" id="popup-distance" style="margin: 10px auto; display: inline-block;"></div>
        </div>
        
      </div>
        <%# --- FIM DOS BOTÕES --- %>

      </div>
    </div>
  </div>
<div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>
</div>

<%= javascript_include_tag "map", type: "module" %>