<div id="assets-data" 
     data-frame-url="<%= image_path('aurea-dourada-mensagens.svg') %>"
     style="display: none;"></div>

<div class="discover-fullscreen-container">

  <div id="map" class="map-fullscreen"></div>

  <div class="discover-header-floating">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo-img" %>
    </div>
    <div class="header-right">
      <button id="gender-filter-toggle" class="btn-gender-icon" title="Filtrar Gênero">
        <%= image_tag "icone-generos.png", class: "icon-generos-img" %>
      </button>
    </div>
  </div>

  <div class="radar-control-floating">
    <div class="radar-badge-box">
      <%= image_tag "icone-300m.png", class: "radar-badge-img" %>
      <span id="range-value-text" class="dynamic-value-text">150m</span>
    </div>
    
    <div class="slider-track-container">
      <%= image_tag "icone-raio.png", class: "slider-track-bg" %>
      <input type="range" id="radar-range" min="1" max="300" value="150" step="1" class="range-slider-custom">
    </div>
  </div>

  <div class="map-fab-container">
    <button id="toggle-visibility-btn" class="fab-button fab-visibility" title="Modo Invisível">
      <svg class="eye-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg class="eye-closed hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
        <line x1="1" y1="1" x2="23" y2="23"></line>
      </svg>
    </button>

    <button class="fab-button" id="fab-center-map" title="Centralizar no meu local">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="1"></circle>
        <path d="M12 8v-2"></path>
        <path d="M12 18v2"></path>
        <path d="M8 12H6"></path>
        <path d="M18 12h2"></path>
      </svg>
    </button>
  </div>

  <div class="users-bottom-sheet">
    <div class="bottom-sheet-handle"><div class="handle-bar"></div></div>
    
    <div class="bottom-sheet-content">
      <div class="bottom-sheet-header">
        <div class="header-users-title">
           <%= image_tag "icone-usuarios-proximos.png", class: "icon-users-header" %>
           <%= image_tag "texto-usuarios-proximos.png", class: "text-users-header" %>
        </div>
        
        <span class="nearby-count" id="nearby-count">0</span>
      </div>
      
      <ul id="users-list" class="users-list-fullscreen">
        <li class="text-center loading-text">Buscando...</li>
      </ul>
    </div>
  </div>

  <div id="user-popup" class="user-popup-fullscreen hidden">
    <div class="popup-overlay"></div>
    <div class="popup-content-fullscreen">
      <button id="close-popup-btn" class="close-popup-btn"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
      <div class="popup-image-carousel"><img id="popup-avatar" src="" class="popup-image"></div>
      <div class="popup-user-info">
        <div class="user-header">
          <div><h3 id="popup-username"></h3><p id="popup-location" class="location-text"></p></div>
          <div class="distance-badge" id="popup-distance"></div>
        </div>
        <div class="popup-actions-fullscreen"><button id="message-btn" class="action-btn-gold">Mensagem</button></div>
      </div>
    </div>
  </div>

</div>

<%= javascript_include_tag "map", type: "module" %>