<div class="full-profile-sheet">
  
  <%# Botão Fechar (Seta para baixo conforme imagem) %>
  <button class="close-profile-btn" onclick="history.back()">
    <i class="fas fa-arrow-down"></i>
  </button>

  <div class="profile-scroll-content">
    
    <%# --- TOPO: CARROSSEL IMERSIVO --- %>
    <div class="profile-carousel-wrapper">
      <div class="profile-carousel">
        <%# Foto de Perfil (Primeira) %>
        <div class="carousel-item">
          <%= image_tag @user.avatar_or_default, class: "carousel-img" %>
        </div>
        
        <%# Fotos do Álbum (Sequência) %>
        <% if @user.album_photos.attached? %>
          <% @user.album_photos.each do |photo| %>
            <div class="carousel-item">
              <%= image_tag photo, class: "carousel-img" %>
            </div>
          <% end %>
        <% end %>
      </div>
      
      <%# Overlay de Informações (Nome, Idade, Distância) %>
      <div class="profile-cover-overlay">
        <div class="cover-info">
          <h2 class="cover-name">
            <%= @user.display_name %>, <span class="cover-age"><%= @user.age %></span>
            <% if @user.respond_to?(:verified) && @user.verified %>
              <i class="fas fa-check-circle verified-badge"></i>
            <% end %>
          </h2>
          <p class="cover-distance">
            <i class="fas fa-location-arrow"></i> a <%= @distance || 2.0 %> km de distância
          </p>
        </div>
      </div>
    </div>

    <div class="profile-body-container">
      
      <%# --- CARD: SOBRE MIM --- %>
      <div class="profile-info-card">
        <h3 class="card-header">SOBRE MIM</h3>
        <div class="card-content-center">
          <p class="profile-bio-text">
            <%= @user.bio.present? ? @user.bio : "Sem biografia." %>
          </p>
        </div>
      </div>

      <%# --- CARD: INFORMAÇÕES BÁSICAS --- %>
      <div class="profile-info-card">
        <h3 class="card-header">INFORMAÇÕES BÁSICAS</h3>
        <div class="basic-info-list">
          <div class="basic-item">
            <span class="basic-icon"><i class="fas fa-venus-mars"></i></span>
            <span class="basic-text"><%= @user.gender.present? ? @user.gender.capitalize : "Não informado" %></span>
          </div>
          <div class="basic-item">
            <span class="basic-icon"><i class="fas fa-search"></i></span>
            <span class="basic-text">Busca: <%= @user.interested_in.present? ? @user.interested_in.capitalize : "Homem" %></span>
          </div>
          <div class="basic-item">
            <span class="basic-icon"><i class="fas fa-map-marker-alt"></i></span>
            <span class="basic-text"><%= @user.city || "Ba" %></span>
          </div>
        </div>
      </div>

      <%# --- BOTÕES DE SEGURANÇA (RODAPÉ) --- %>
      <div class="profile-safety-actions">
        <div class="safety-divider"></div>
        
        <button class="btn-safety-block">
          DENUNCIAR <%= @user.display_name.upcase %>
        </button>

        <div class="safety-separator"></div>

        <button class="btn-safety-block">
          BLOQUEAR <%= @user.display_name.upcase %>
        </button>
        
        <div class="safety-divider"></div>
      </div>

      <div class="bottom-spacer"></div>
    </div>
  </div>
</div>