<div class="profile-dashboard-wrapper" style="overflow-x: hidden; width: 100%; max-width: 100vw;">
  
  <%# --- 1. HEADER (Apenas o Título) --- %>
  <div class="profile-header-container">
    <div class="header-left">
      <%= image_tag "texto-perfil.png", alt: "Perfil", class: "header-title-sm" %>
    </div>
    <div class="header-right">
      <button class="header-btn"
        data-controller="theme"
        data-action="click->theme#toggle"
        data-theme-sol-icon="<%= asset_path('sol-dourado.svg') %>"
        data-theme-lua-icon="<%= asset_path('lua-dourado.svg') %>">
        <%= image_tag "sol-dourado.svg", alt: "Tema", data: { theme_target: "icon" } %>
      </button>
    </div>
  </div>

  <%# --- 2. HERO SECTION (Avatar | Info | Ajuda) --- %>
  <div class="profile-hero">
    
    <%# ESQUERDA: Avatar %>
    <div class="hero-avatar-container">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, class: "hero-avatar-img" %>
      <% else %>
        <%= image_tag "default-avatar.png", class: "hero-avatar-img" %>
      <% end %>
      <%= image_tag "aurea-dourada-mensagens.svg", class: "hero-ring" %>
    </div>

    <%# CENTRO: Nome e Botão Editar %>
    <div class="hero-info">
      <h2 class="hero-name">
        <%= @user.display_name.split.first %>, <%= @user.age %>
        
        <%# --- LÓGICA: Exibe ícone APENAS se verificado --- %>
        <% if @user&.verified? %>
          <%= image_tag "icone-verificar.png", class: "verified-icon-name", title: "Perfil Verificado" %>
        <% end %>
      </h2>
      
      <%= link_to edit_profile_path, class: "btn-edit-pill" do %>
        <i class="fas fa-pen"></i> Completar perfil
      <% end %>
    </div>

   <%# DIREITA: Botão Ajuda (AGORA COM LINK) %>
    <div class="hero-help">
      <%= link_to safety_center_path, class: "btn-help-png" do %>
        <%= image_tag "botao-ajuda.png", alt: "Ajuda" %>
      <% end %>
      <span class="help-label">Ajuda</span>
    </div>

  </div>

  <%# --- 3. BANNER VERIFICAÇÃO (Lógica condicional) --- %>
  <% unless @user&.verified? %>
    <%= link_to verification_path, class: "verification-banner" do %>
      <div class="icon-box">
        <%= image_tag "icone-verificar.png", class: "verify-icon-lg" %>
      </div>
      <div class="banner-text">
        <strong>Verifique seu Perfil</strong>
        <p class="banner-description">
          Ajuda a proteger os usuários contra perfis que tentam se passar por outros para enganar as pessoas.
        </p>
        <div class="progress-bar-lines">
          <span class="line full"></span>
          <span class="line full"></span>
          <span class="line"></span>
        </div>
      </div>
      <div class="banner-arrow">›</div>
    <% end %>
  <% end %>

  <%# --- 4. SEÇÃO DESTAQUE --- %>
  <div class="highlight-section">
    <div class="highlight-photo">
      <%= image_tag "mao_comprimento.png", class: "photo-cover" %>
    </div>
    
    <div class="highlight-text-content">
      <h3 class="highlight-title">Integração com Eventos</h3>
      <p class="highlight-description">
        Participe de eventos especiais, faça check-in com QR code e descubra pessoas com interesses similares em festivais e encontros.
      </p>
    </div>
  </div>

<%# --- 5. BLOCO UPGRADE (CARROSSEL) --- %>
  <div class="upgrade-carousel-container">
    <div class="upgrade-track">
      <%# Plano Grátis %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade.png", class: "upgrade-img-responsive" %>
      <% end %>

      <%# Plano Plus %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade-plus.png", class: "upgrade-img-responsive" %>
      <% end %>

      <%# Plano Gold %>
      <%= link_to plans_path, class: "upgrade-card" do %>
        <%= image_tag "bloco-upgrade-gold.png", class: "upgrade-img-responsive" %>
      <% end %>
    </div>
  </div>

</div> <%# fecha o upgrade-carousel-container %>

  <%# --- 6. AÇÕES DA CONTA (SAIR / EXCLUIR) --- %>
  <div class="profile-account-actions">
    
    <%# --- MUDANÇA AQUI: O botão agora só abre o modal --- %>
    <button type="button" class="btn-logout" onclick="document.getElementById('logout-modal').classList.add('show')" style="border: none; background: transparent; width: 100%;">
      <i class="fas fa-sign-out-alt"></i> Sair
    </button>


    <%# Botão Encerrar Conta %>
    <%= button_to user_registration_path, method: :delete, data: { turbo_confirm: "Tem certeza que deseja excluir sua conta? Essa ação não pode ser desfeita." }, class: "btn-delete-account" do %>
      Encerrar minha conta
    <% end %>

  </div>

</div> <%# fecha o profile-dashboard-wrapper (que já existia no final do seu arquivo) %>

<%# --- MODAL DE CONFIRMAÇÃO DE LOGOUT --- %>
<div id="logout-modal" class="logout-modal-overlay">
  <div class="logout-modal-content">
    
    <div class="logout-icon">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
    </div>

    <h3>Sair do GeoMatch?</h3>
    <p>Tem certeza que deseja sair do app GeoMatch?</p>

    <div class="logout-actions">
      <%# BOTÃO NÃO: Apenas fecha o modal %>
      <button type="button" class="btn-cancel" onclick="document.getElementById('logout-modal').classList.remove('show')">
        Não
      </button>

      <%# BOTÃO SIM: Realiza o Logout de verdade %>
      <%= link_to logout_path, data: { turbo_method: :delete }, class: "btn-confirm" do %>
        Sim
      <% end %>
    </div>

  </div>
</div>

</div>