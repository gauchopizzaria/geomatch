<div class="geomatch-screen-wrapper" data-controller="lead-swipe filters">
  
  <%# --- 1. HEADER (Fixo) --- %>
  <div class="geomatch-header">
    <div class="header-left">
      <%= image_tag "logo-geomatch-dourada.png", class: "header-logo", alt: "GeoMatch" %>
    </div>
    <div class="header-right">
      <button class="header-btn" data-action="click->filters#open">
        <%= image_tag "filtro-dourado.svg", alt: "Filtros" %>
      </button>
     <button class="header-btn" 
        data-controller="theme" 
        data-action="click->theme#toggle"
        data-theme-sol-icon="<%= asset_path('sol-dourado.svg') %>"
        data-theme-lua-icon="<%= asset_path('lua-dourado.svg') %>">
  <%= image_tag "sol-dourado.svg", alt: "Tema", data: { theme_target: "icon" } %>
</button>
    </div>
  </div>

  <%# --- 2. POPUP DE MATCH (Se houver) --- %>
  <% if @match %>
    <div class="match-popup" data-match-popup>
      <div class="match-popup-content">
        <div class="match-animation"><span class="match-icon">💕</span></div>
        <h2 class="match-title">Deu Match!</h2>
        <p class="match-subtitle">Você e <strong><%= @next_user.display_name %></strong> curtiram um ao outro!</p>
        <div class="match-actions">
          <%= link_to "💬 Conversar Agora", match_path(@match), class: "btn btn-match btn-primary" %>
          <%= link_to "➡ Continuar", lead_path, class: "btn btn-match btn-secondary" %>
        </div>
      </div>
      <div class="match-overlay"></div>
    </div>
  <% end %>

  <%# --- 3. ÁREA PRINCIPAL (Cards) --- %>
  <div class="geomatch-main-area">
    <% if @next_user %>
      
      <%# --- CARD DO USUÁRIO --- %>
      <div class="gold-card-frame" data-lead-swipe-target="card" data-user-id="<%= @next_user.id %>">
        
        <div class="card-gallery">
          <%# Barra de Progresso %>
          <div class="progress-bar-container">
            <% album_photos = @next_user.album_photos.attached? ? @next_user.album_photos : [] %>
            <% avatar = @next_user.avatar.attached? %>
            <% photos = [] %>
            <% photos << { url: rails_blob_url(@next_user.avatar) } if avatar %>
            <% album_photos.each { |p| photos << { url: rails_blob_url(p) } } %>

            <% photos.each_with_index do |_, index| %>
              <div class="progress-step <%= 'active' if index == 0 %>" data-lead-swipe-target="indicator"></div>
            <% end %>
          </div>

          <%# Slides de Fotos %>
          <div class="slides-container">
            <% photos.each_with_index do |photo, index| %>
              <div class="slide-item <%= 'active' if index == 0 %>" data-lead-swipe-target="slide">
                <img src="<%= photo[:url] %>" class="slide-img no-drag">
                <div class="slide-gradient"></div>
              </div>
            <% end %>
          </div>

          <%# Navegação por Toque (Esquerda/Direita) %>
          <div class="tap-nav-overlay">
            <div class="tap-left" data-action="click->lead-swipe#prevSlide"></div>
            <div class="tap-right" data-action="click->lead-swipe#nextSlide"></div>
          </div>

          <%# Informações Resumidas (Clicável para abrir perfil) %>
          <div class="card-user-info clickable-info" data-action="click->lead-swipe#openProfile">
            <div class="info-header">
                <div class="location-badge">
                  <i class="fas fa-map-marker-alt"></i> Perto de mim
                </div>
                <%# Ícone animado indicando que pode subir %>
                <div class="info-up-indicator">
                    <i class="fas fa-chevron-up"></i>
                </div>
            </div>

            <h2 class="user-title" style="display: flex; align-items: center; gap: 5px;">
              <%= @next_user.display_name %> <span class="age"><%= @next_user.age %></span>
              <% if @next_user&.verified? %>
                <%= image_tag "icone-verificar.png", style: "width: 20px; height: 20px;", title: "Perfil Verificado" %>
              <% end %>
            </h2>
            
            <p class="user-distance">
              <i class="fas fa-location-arrow"></i> a <%= @distance || 1 %> km de distância
            </p>

            <%# Pequena prévia da bio %>
            <% if @next_user.respond_to?(:bio) && @next_user.bio.present? %>
               <p class="user-bio-preview" style="font-size: 0.85rem; opacity: 0.8; margin-top: 5px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;">
                 <%= @next_user.bio %>
               </p>
            <% end %>
          </div>
        </div> 
      </div> 
      
      <%# --- BOTÕES DE AÇÃO (Floating) --- %>
      <div class="action-buttons-container">
        <%= button_to reject_user_path(user_id: @next_user.id), method: :post, class: "action-btn btn-reject", form_class: "btn-form" do %>
          <%= image_tag "botao-rejeitar.svg", alt: "Rejeitar" %>
        <% end %>

        <%= button_to start_chat_path(user_id: @next_user.id), method: :post, class: "action-btn btn-chat", form_class: "btn-form" do %>
          <%= image_tag "mensagem-prata.svg", alt: "Chat" %>
        <% end %>

        <%= button_to likes_path(user_id: @next_user.id), method: :post, class: "action-btn btn-like", form_class: "btn-form" do %>
          <div class="heart-icon-wrapper">
             <%= image_tag "coracao-chapada.png", alt: "Curtir" %>
          </div>
        <% end %>
      </div>

    <% else %>
      <%# --- EMPTY STATE --- %>
      <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <h3>Sem mais usuários por perto</h3>
        <button class="btn-gold-outline" data-action="click->filters#open">
          Ajustar Filtros
        </button>
      </div>
    <% end %>
  </div>

  <%# ========================================== %>
  <%#       PERFIL COMPLETO (ESTILO PREMIUM)     %>
  <%# ========================================== %>
  <% if @next_user %>
    <div class="full-profile-sheet" data-lead-swipe-target="profileModal">
      
      <%# Botão Fechar Flutuante %>
      <button class="close-profile-btn" data-action="click->lead-swipe#closeProfile">
          <i class="fas fa-arrow-down"></i>
      </button>

      <div class="profile-scroll-content">
          
          <%# --- CAPA (IMERSIVA) --- %>
          <div class="profile-cover-section">
              <%# Lógica para pegar a melhor foto de capa %>
              <% cover_url = @next_user.avatar.attached? ? url_for(@next_user.avatar) : (@next_user.album_photos.attached? ? url_for(@next_user.album_photos.first) : 'default-avatar.png') %>
              
              <%= image_tag cover_url, class: "profile-cover-img" %>
              
              <div class="profile-cover-overlay">
                  <div class="cover-info">
                      <h2 class="cover-name">
                          <%= @next_user.display_name %> 
                          <span class="cover-age"><%= @next_user.age %></span>
                          <% if @next_user.respond_to?(:verified) && @next_user.verified %>
                              <%= image_tag "verificado.svg", class: "cover-verified" rescue nil %>
                          <% end %>
                      </h2>
                      <% if @next_user.respond_to?(:job_title) && @next_user.job_title.present? %>
                          <p class="cover-job"><i class="fas fa-briefcase"></i> <%= @next_user.job_title %></p>
                      <% end %>
                      <p class="cover-distance"><i class="fas fa-location-arrow"></i> a <%= @distance || 1 %> km de distância</p>
                  </div>
              </div>
          </div>

          <div class="profile-body-container">
              
              <%# --- CARD: SOBRE MIM --- %>
              <div class="profile-info-card">
                  <h3 class="card-header">Sobre mim</h3>
                  <p class="profile-bio-text">
                      <%= @next_user.bio.present? ? @next_user.bio : "Sem biografia." %>
                  </p>
              </div>

              <%# --- CARD: INFORMAÇÕES BÁSICAS --- %>
              <div class="profile-info-card">
                  <h3 class="card-header">Informações básicas</h3>
                  <div class="basic-info-list">
                      <div class="basic-item">
                          <span class="basic-icon">⚧</span>
                          <span class="basic-text"><%= @next_user.gender.present? ? @next_user.gender.capitalize : "Não informado" %></span>
                      </div>
                      <div class="basic-item">
                          <span class="basic-icon">👀</span>
                          <span class="basic-text">Busca: <%= @next_user.interested_in.present? ? @next_user.interested_in.capitalize : "Todos" %></span>
                      </div>
                      <div class="basic-item">
                          <span class="basic-icon">📍</span>
                          <span class="basic-text"><%= @next_user.city || "Localização oculta" %></span>
                      </div>
                  </div>
              </div>

              <%# --- CARD: INTERESSES --- %>
              <% if @next_user.respond_to?(:hobbies_list) && @next_user.hobbies_list.any? %>
                  <div class="profile-info-card">
                      <h3 class="card-header">Interesses</h3>
                      <div class="tags-container">
                          <% @next_user.hobbies_list.each do |hobby| %>
                              <span class="tag-pill"><%= hobby %></span>
                          <% end %>
                      </div>
                  </div>
              <% end %>

              <%# --- GALERIA DE FOTOS (RESTANTE) --- %>
              <% if @next_user.album_photos.attached? %>
                  <div class="profile-gallery-grid">
                      <%# Mostra todas as fotos ou pula a primeira se já for a capa %>
                      <% photos_to_show = @next_user.avatar.attached? ? @next_user.album_photos : @next_user.album_photos.drop(1) %>
                      <% photos_to_show.each do |photo| %>
                          <div class="gallery-item">
                              <%= image_tag photo, class: "gallery-img" %>
                          </div>
                      <% end %>
                  </div>
              <% end %>

              <%# --- BOTÕES DE SEGURANÇA (RODAPÉ) --- %>
              <div class="profile-safety-actions">
                  <div class="safety-divider"></div>
                  
                  <%= button_to report_incident_path(user_id: @next_user.id), 
                      method: :get, 
                      class: "btn-safety-block" do %>
                      DENUNCIAR <%= @next_user.display_name.upcase %>
                  <% end %>

                  <div class="safety-separator"></div>

                  <%= button_to block_user_path(@next_user), 
                      method: :post, 
                      class: "btn-safety-block",
                      data: { confirm: "Bloquear este usuário?" } do %>
                      BLOQUEAR <%= @next_user.display_name.upcase %>
                  <% end %>
                  
                  <div class="safety-divider"></div>
              </div>

              <div class="bottom-spacer"></div>
          </div>
      </div>
    </div>
  <% end %>

  <%# --- 5. MODAL DE FILTROS --- %>
  <div class="filter-modal hidden" data-filters-target="modal">
    <div class="filter-backdrop" data-action="click->filters#close"></div>
    
    <div class="filter-content theme-dark">
      <%= form_tag lead_path, method: :get, data: { filters_target: "form" } do %>
        
        <div class="filter-header">
          <h2>Filtros</h2>
          <button type="button" class="close-btn" data-action="click->filters#close">✖</button>
        </div>

        <div class="filter-section">
          <div class="label-row">
            <span class="label-title">Distância máxima</span>
            <span class="label-value">
              <span data-filters-target="distanceValue"><%= @filter_distance %></span> km
            </span>
          </div>

          <div class="range-slider-container">
            <input type="range" name="distance" min="5" max="500" step="5"
                   value="<%= @filter_distance %>" 
                   class="range-input" 
                   data-filters-target="distanceInput"
                   data-action="input->filters#updateDistanceVisual">
          </div>
          
          <div class="toggle-row">
             <p>Ver pessoas um pouco mais distantes se acabar</p>
             <label class="switch">
               <input type="checkbox" checked>
               <span class="slider round"></span>
             </label>
          </div>
        </div>

        <hr class="filter-divider">

        <div class="filter-section">
          <div class="label-row">
            <span class="label-title">Faixa Etária</span>
            <span class="label-value">
              <span data-filters-target="ageDisplay">
                <%= @filter_min_age %> - <%= @filter_max_age %>
              </span> anos
            </span>
          </div>

          <div class="dual-range-wrapper">
             <div class="range-labels-sub">Mínima / Máxima</div>
             
             <input type="range" name="min_age" min="18" max="100" 
                    value="<%= @filter_min_age %>" 
                    class="range-input age-range mb-2" 
                    data-filters-target="minAgeInput"
                    data-action="input->filters#updateAgeVisual">
             
             <input type="range" name="max_age" min="18" max="100" 
                    value="<%= @filter_max_age %>" 
                    class="range-input age-range" 
                    data-filters-target="maxAgeInput"
                    data-action="input->filters#updateAgeVisual">
          </div>
        </div>

        <div class="filter-actions">
          <button type="submit" class="btn-apply">Aplicar Filtros</button>
        </div>

      <% end %>
    </div>
  </div>
<div id="upgrade-modal-container" style="position: relative; z-index: 99999;"></div>
</div>