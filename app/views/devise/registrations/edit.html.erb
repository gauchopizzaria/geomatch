<div class="devise-container">
  <div class="devise-form-card">
    <h2>Editar Perfil</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# --- 1. Dados Pessoais --- %>
      <div class="field">
        <%= f.label :username, "Nome Completo" %>
        <%= f.text_field :username, placeholder: "Seu nome completo" %>
      </div>

      <div class="field">
        <%= f.label :birthdate, "Data de Nascimento" %>
        <%= f.date_field :birthdate %>
      </div>

      <div class="field">
        <%= f.label :address, "Cidade" %>
        <%= f.text_field :address, placeholder: "Sua cidade" %>
      </div>

      <div class="field">
        <%= f.label :phone, "Telefone / WhatsApp" %>
        <%= f.telephone_field :phone, placeholder: "(XX) 99999-9999" %>
      </div>

      <%# --- 2. Dados de Acesso --- %>
      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="alert alert-info">Aguardando confirmação para: <%= resource.unconfirmed_email %></div>
      <% end %>

      <div class="field">
        <%= f.label :password, "Nova Senha" %> 
        <i style="font-size: 0.8rem; color: #888;">(deixe em branco se não quiser alterar)</i>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••" %>
        <% if @minimum_password_length %>
          <em class="password-hint"><%= @minimum_password_length %> caracteres no mínimo</em>
        <% end %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmar Nova Senha" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••" %>
      </div>

      <div class="field">
        <%= f.label :current_password, "Senha Atual" %> 
        <i style="font-size: 0.8rem; color: #888;">(necessário para salvar as alterações)</i>
        <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "••••••••" %>
      </div>

      <div class="actions">
        <%= f.submit "Atualizar", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%# --- Área de Exclusão (Opcional, pois você já tem no perfil) --- %>
    <hr style="margin: 30px 0; border-color: #eee;">
    
    <h3>Cancelar conta</h3>
    <div style="margin-bottom: 20px;">
      <p>Não está satisfeito?</p>
      <%= button_to "Cancelar minha conta", registration_path(resource_name), data: { confirm: "Tem certeza?", turbo_confirm: "Tem certeza que deseja apagar sua conta?" }, method: :delete, class: "btn-delete-account" %>
    </div>

    <div class="devise-links">
      <%= link_to "Voltar", :back %>
    </div>
  </div>
</div>