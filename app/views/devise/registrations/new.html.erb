<div class="devise-container">
  <div class="devise-form-card">
    <h2>Cadastre-se no GeoMatch</h2>

    <%#
      @from_google é setado pelo Users::RegistrationsController antes da action.
      Quando true: esconde o botão Google (já viemos dele) e exibe o banner dourado.
      Quando false: exibe o botão Google para iniciar o fluxo OAuth.
    %>

    <% if @from_google %>
      <%# Banner dark/gold que combina com o tema do GeoMatch %>
      <div class="google-signup-banner">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"
             width="18" height="18" aria-hidden="true" class="google-signup-banner__icon">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <span>Quase lá! Complete seu perfil para entrar no GeoMatch.</span>
      </div>
    <% else %>
      <%# Mesma lógica do sessions/new: button_to + form_class: + form: { data: } %>
      <%= button_to user_google_oauth2_omniauth_authorize_path,
            class: "btn-google-auth",
            form_class: "form-google-auth",
            form: { data: { turbo: false } } do %>
        <img src="https://www.svgrepo.com/show/475656/google-color.svg"
             alt="Google" class="google-icon">
        Cadastrar com o Google
      <% end %>

      <div class="oauth-divider">
        <span>ou preencha o formulário</span>
      </div>
    <% end %>

    <%#
      data: { turbo: false } no form_for é obrigatório com Devise + Turbo/Rails 8.
      Sem isso o Turbo trata o redirect do Devise como um fetch e quebra o fluxo.
    %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# --- 1. Nome Completo --- %>
      <div class="field">
        <%= f.label :username, "Nome Completo" %>
        <%= f.text_field :username,
              autofocus: !@from_google,
              placeholder: "Ex: João Silva",
              required: true,
              class: "form-input" %>
      </div>

      <%# --- 2. Gênero --- %>
      <div class="field">
        <%= f.label :gender, "Gênero" %>
        <%= f.select :gender,
              options_for_select([
                ['Homem', 'Homem'],
                ['Mulher', 'Mulher'],
                ['Não Binário', 'Não Binário']
              ]),
              { prompt: "Selecione seu gênero" },
              { class: "form-input", required: true } %>
      </div>

      <%# --- 3. Escolaridade --- %>
      <div class="field">
        <%= f.label :education_level, "Escolaridade" %>
        <%= f.select :education_level,
              options_for_select([
                ['Ensino Médio', 'high_school'],
                ['Ensino Superior Incompleto', 'college_incomplete'],
                ['Ensino Superior Completo', 'college_complete']
              ], resource.education_level),
              { prompt: "Selecione sua escolaridade" },
              { class: "form-input", required: true } %>
      </div>

      <%# --- 4. Data de Nascimento --- %>
      <div class="field">
        <%= f.label :birthdate, "Data de Nascimento" %>
        <%= f.date_field :birthdate, required: true, class: "form-input" %>
      </div>

      <%# --- 5. Endereço via CEP (Stimulus: address) --- %>
      <div data-controller="address">
        <div class="field">
          <%= f.label :zip_code, "CEP" %>
          <%= f.text_field :zip_code,
                placeholder: "00000-000",
                required: true,
                class: "form-input",
                maxlength: 9,
                data: {
                  address_target: "zipCode",
                  action: "blur->address#lookup"
                } %>
          <span class="field-hint" data-address-target="feedback"
                style="color: #e74c3c; font-size: 0.85rem;"></span>
        </div>

        <div class="field">
          <%= f.label :street, "Rua / Logradouro" %>
          <%= f.text_field :street,
                placeholder: "Preenchido automaticamente",
                class: "form-input",
                readonly: true,
                data: { address_target: "street" } %>
        </div>

        <div class="field">
          <%= f.label :neighborhood, "Bairro" %>
          <%= f.text_field :neighborhood,
                placeholder: "Preenchido automaticamente",
                class: "form-input",
                readonly: true,
                data: { address_target: "neighborhood" } %>
        </div>

        <div style="display: flex; gap: 12px;">
          <div class="field" style="flex: 1;">
            <%= f.label :city, "Cidade" %>
            <%= f.text_field :city,
                  placeholder: "Preenchido automaticamente",
                  class: "form-input",
                  readonly: true,
                  data: { address_target: "city" } %>
          </div>

          <div class="field" style="flex: 0 0 80px;">
            <%= f.label :state, "UF" %>
            <%= f.text_field :state,
                  placeholder: "UF",
                  class: "form-input",
                  readonly: true,
                  maxlength: 2,
                  data: { address_target: "state" } %>
          </div>
        </div>
      </div>

      <%# --- 6. Telefone --- %>
      <div class="field">
        <%= f.label :phone, "Telefone / WhatsApp" %>
        <%= f.telephone_field :phone,
              placeholder: "(XX) 99999-9999",
              required: true,
              class: "form-input" %>
      </div>

      <%# --- 7. E-mail ---
        Quando @from_google: campo pré-preenchido (via User.new_with_session),
        readonly para impedir edição, e classe extra para feedback visual.
      %>
      <div class="field">
        <%= f.label :email %>
        <% if @from_google %>
          <%= f.email_field :email,
                autocomplete: "off",
                required: true,
                class: "form-input form-input--locked",
                readonly: true,
                tabindex: "-1" %>
          <span class="field-hint field-hint--locked">
            &#128274; E-mail vinculado à sua conta Google — não pode ser alterado.
          </span>
        <% else %>
          <%= f.email_field :email,
                autocomplete: "email",
                placeholder: "seu.email@exemplo.com",
                required: true,
                class: "form-input" %>
        <% end %>
      </div>

      <%# --- 8. Senha --- %>
      <div class="field">
        <%= f.label :password %>
        <% if @minimum_password_length %>
          <em class="password-hint">(<%= @minimum_password_length %> caracteres no mínimo)</em>
        <% end %>
        <%= f.password_field :password,
              autocomplete: "new-password",
              placeholder: "••••••••",
              required: true,
              class: "form-input" %>
      </div>

      <%# --- 9. Confirmação de Senha --- %>
      <div class="field">
        <%= f.label :password_confirmation, "Confirmação de Senha" %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              placeholder: "••••••••",
              required: true,
              class: "form-input" %>
      </div>

      <%# --- 10. Termos e Políticas --- %>
      <div class="terms-container">
        <div class="checkbox-field">
          <%= f.check_box :terms_of_use, id: "terms-check" %>
          <label for="terms-check">
            Li e aceito os <%= link_to "Termos de Uso", terms_path, target: "_blank" %>
          </label>
        </div>

        <div class="checkbox-field">
          <%= f.check_box :data_policy, id: "policy-check" %>
          <label for="policy-check">
            Aceito a <%= link_to "Política de Uso de Dados", privacy_path, target: "_blank" %>
          </label>
        </div>
      </div>

      <div class="actions">
        <%= f.submit @from_google ? "Concluir Cadastro" : "Cadastrar",
              class: "btn btn-primary" %>
      </div>
    <% end %>

    <div class="devise-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
