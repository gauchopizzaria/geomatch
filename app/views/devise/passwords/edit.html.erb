<!-- app/views/devise/passwords/edit.html.erb -->

<div class="devise-container">
  <div class="devise-form-card">
    <h2>Alterar sua senha</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field">
        <%= f.label :password, "Nova senha" %>  

        <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> caracteres no mínimo)</em>  

        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "••••••••" %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmar nova senha" %>  

        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••" %>
      </div>

      <div class="actions">
        <%= f.submit "Alterar minha senha", class: "btn btn-primary" %>
      </div>
    <% end %>

    <div class="devise-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>