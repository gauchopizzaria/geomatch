<% if turbo_native_app? %>
  <div class="native-app-cta">
    <%= link_to "Cadastrar", new_user_registration_path, class: "native-btn native-btn-primary" %>
    <%= link_to "Entrar", new_user_session_path, class: "native-btn native-btn-outline" %>
  </div>
<% end %>

<section class="landing-hero">
  <div class="hero-content">
    <h1>Descubra Pessoas Próximas.</h1>
    <p class="lead">
      Conecte-se instântaneamente com pessoas no raio de 300m usando nosso Modo Livre. Perfeito para eventos como Carnaval.
    </p>

    <div class="hero-ctas">
      <%= link_to "Cadastre-se com E-mail ou Telefone", new_user_registration_path, class: "btn btn-primary" %>
    </div>

    <p class="cta-separator">Ou</p>

    <div class="hero-ctas social-ctas">
      <%= link_to "Continuar com Google", "#", class: "btn btn-social btn-google" %>
      <%= link_to "Continuar com Facebook", "#", class: "btn btn-social btn-facebook" %>
    </div>
  </div>

  <div class="hero-visual">
    <%= image_tag "hero_visual.png", alt: "Visual de mapa e perfis", class: "hero-image" %>
  </div>
</section>

<!-- SEÇÃO 1 — CONFIANÇA -->
<section class="section section-light">
  <div class="section-grid">
    <div class="section-text">
      <h2>Interações Seguras e Consensuais</h2>
      <p>Ative o Modo Livre quando quiser se conectar. Você controla quando e com quem interagir.</p>
      <p class="highlight">Mostre seu melhor eu e encontre relações que realmente importam.</p>
      <%= link_to "Registrar-se", new_user_registration_path, class: "btn btn-primary" %>
    </div>
    <div class="section-image">
      <%= image_tag "mao_comprimento.png", alt: "Mãos se cumprimentando" %>
    </div>
  </div>
</section>

<!-- SEÇÃO 2 — CONVERSAS REAIS -->
<section class="section section-gold">
  <div class="section-grid reverse">
    <div class="section-image">
      <%= image_tag "confiança.png", alt: "A fim de conversar agora?" %>
    </div>
    <div class="section-text">
      <h2>Integração com Eventos</h2>
      <p>Participe de eventos especiais, faça check-in com QR code e descubra pessoas com interesses similares em festivais  e encontros.</p>
      <%= link_to "Registrar-se", new_user_registration_path, class: "btn btn-outline" %>
    </div>
  </div>
</section>

<!-- SEÇÃO 3 — PERFIS -->
<section class="section section-light">
  <div class="section-grid">
    <div class="section-text">
      <h2>Defina como quer se conectar .</h2>
      <p>Uma conversa casual, uma nova amizade, um parceiro de networking ou algo mais.</p>
      <p>O GeoMatch se adapta ao seu momento.</p>
      <%= link_to "Registrar-se", new_user_registration_path, class: "btn btn-primary" %>
    </div>
    <div class="section-image">
      <%= image_tag "perfis.png", alt: "Perfis de usuários" %>
    </div>
  </div>
</section>

<!-- SEÇÃO 4 — SEGURANÇA -->
<section class="section sectio  n-gray">
  <div class="section-grid reverse">
    <div class="section-image">
      <%= image_tag "seguranca.png", alt: "Ilustração de segurança" %>
    </div>
    <div class="section-text">
      <h2>Segurança em primeiro lugar, sempre.</h2>
      <p>Nossa prioridade máxima é a sua segurança. Acesse o Safety Centre para suporte e informações.</p>
      <%= link_to "Visite o Safety Centre",  class: "btn btn-outline" %>
    </div>
  </div>
</section>

