            <path d="M 50 4 C 25 4, 5 23, 5 48 C 5 70, 30 96, 50 126 C 70 96, 95 70, 95 48 C 95 23, 75 4, 50 4 Z"/>
          </clipPath>
        </defs>
        <path d="M 50 4 C 25 4, 5 23, 5 48 C 5 70, 30 96, 50 126 C 70 96, 95 70, 95 48 C 95 23, 75 4, 50 4 Z" fill="url(#gmGoldGrad)"/>
        <path d="M 50 4 C 25 4, 5 23, 5 48 C 5 70, 30 96, 50 126 C 70 96, 95 70, 95 48 C 95 23, 75 4, 50 4 Z" fill="url(#gmInnerLight)"/>
        <circle cx="50" cy="44" r="21" fill="#0a0a0a"/>
        <text x="50" y="54" text-anchor="middle" font-family="'Nunito', system-ui, sans-serif" font-weight="900" font-size="30" fill="url(#gmGoldGradG)">G</text>
        <path class="map-loading__heart" d="M 50 84.5 C 50 81.5 46.5 79 43 79 C 39.5 79 37 81.5 37 85.2 C 37 91 50 99 50 99 C 50 99 63 91 63 85.2 C 63 81.5 60.5 79 57 79 C 53.5 79 50 81.5 50 84.5 Z" fill="#0a0a0a"/>
