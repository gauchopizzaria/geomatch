          <g transform="rotate(18 50 65)">
            <rect class="map-loading__shimmer" x="-25" y="-30" width="22" height="200" fill="url(#gmShimmer)"/>
          </g>
        </g>
        <path d="M 50 4 C 25 4, 5 23, 5 48 C 5 70, 30 96, 50 126 C 70 96, 95 70, 95 48 C 95 23, 75 4, 50 4 Z" fill="none" stroke="rgba(0,0,0,0.35)" stroke-width="0.5"/>
