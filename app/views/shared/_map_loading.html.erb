          <radialGradient id="gmInnerLight" cx="0.3" cy="0.25" r="0.85">
            <stop offset="0%"   stop-color="#FFFFFF" stop-opacity="0.25"/>
            <stop offset="40%"  stop-color="#FFFFFF" stop-opacity="0.05"/>
            <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
          </radialGradient>
