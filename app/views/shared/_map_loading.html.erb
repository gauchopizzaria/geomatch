      <span class="map-loading__radar map-loading__radar--2"></span>
      <span class="map-loading__radar map-loading__radar--3"></span>
    </div>
    <div class="map-loading__pin">
      <svg viewBox="0 0 100 130" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="gmGoldGrad" x1="0.12" y1="0.05" x2="0.88" y2="1">
            <stop offset="0%"   stop-color="#F4DFC4"/>
            <stop offset="48%"  stop-color="#C9A079"/>
            <stop offset="100%" stop-color="#6E4F38"/>
          </linearGradient>
          <linearGradient id="gmGoldGradG" x1="0.2" y1="0" x2="0.8" y2="1">
            <stop offset="0%"   stop-color="#F4DFC4"/>
            <stop offset="100%" stop-color="#C9A079"/>
          </linearGradient>
          <linearGradient id="gmShimmer" x1="0" y1="0" x2="1" y2="0">
