<%# Locals: image_url, form_url, cancel_path, title, aspect_ratio (e.g. "3/4") %>
<% aspect_parts = aspect_ratio.to_s.split("/") %>
<% aw = aspect_parts[0].to_i %>
<% ah = aspect_parts[1].to_i %>

<div class="gm-crop"
     data-controller="crop-screen"
     data-crop-screen-aspect-w-value="<%= aw %>"
     data-crop-screen-aspect-h-value="<%= ah %>"
     data-crop-screen-cancel-path-value="<%= cancel_path %>">

  <%= form_with url: form_url, method: :post,
                data: { "crop-screen-target": "form" },
                class: "gm-crop__form" do %>

    <%= hidden_field_tag :crop_data, "", data: { "crop-screen-target": "field" } %>

    <header class="gm-crop__header">
      <button type="button"
              class="gm-crop__btn gm-crop__btn--cancel"
              data-action="click->crop-screen#cancel">Cancelar</button>

      <h1 class="gm-crop__title"><%= title %></h1>

      <button type="submit"
              class="gm-crop__btn gm-crop__btn--confirm"
              data-action="click->crop-screen#confirm">Confirmar</button>
    </header>

    <div class="gm-crop__wrap" data-crop-screen-target="wrap">
      <div class="gm-crop__photo-area">
        <img src="<%= image_url %>"
             data-crop-screen-target="photo"
             class="gm-crop__photo"
             alt="">
      </div>

      <div class="gm-crop__box"
           data-crop-screen-target="box"
           style="aspect-ratio: <%= aw %>/<%= ah %>;">
        <span class="gm-crop__corner gm-crop__corner--tl"></span>
        <span class="gm-crop__corner gm-crop__corner--tr"></span>
        <span class="gm-crop__corner gm-crop__corner--bl"></span>
        <span class="gm-crop__corner gm-crop__corner--br"></span>
      </div>

      <div class="gm-crop__aspect">
        <span class="gm-crop__aspect-dot"></span>
        <span><%= aw %>:<%= ah %></span>
        <span class="gm-crop__aspect-sep"></span>
        <span class="gm-crop__aspect-label">Proporção</span>
      </div>
    </div>

    <footer class="gm-crop__footer">
      <div class="gm-crop__tools">
        <button type="button" class="gm-crop__tool" data-action="click->crop-screen#zoomOut">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </button>
        <button type="button" class="gm-crop__tool" data-action="click->crop-screen#zoomIn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </button>
        <button type="button" class="gm-crop__tool" data-action="click->crop-screen#rotate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"/>
            <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
          </svg>
        </button>
        <button type="button" class="gm-crop__tool" data-action="click->crop-screen#flip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="17 1 21 5 17 9"/>
            <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
            <polyline points="7 23 3 19 7 15"/>
            <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
          </svg>
        </button>
      </div>
      <p class="gm-crop__hint">Arraste para mover · Pinça para zoom</p>
    </footer>

  <% end %>
</div>
