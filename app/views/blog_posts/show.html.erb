<!-- Article Schema para SEO -->
<script type="application/ld+json">
<%= {
  "@context": "https://schema.org/",
  "@type": "Article",
  "headline": @blog_post.title,
  "description": @blog_post.excerpt.present? ? @blog_post.excerpt : truncate(@blog_post.content, length: 160),
  "image": @blog_post.featured_image.present? ? image_url(@blog_post.featured_image) : image_url("logo-geomatch.svg"),
  "datePublished": @blog_post.published_at.iso8601,
  "dateModified": @blog_post.updated_at.iso8601,
  "author": {
    "@type": "Person",
    "name": @blog_post.user.display_name
  },
  "publisher": {
    "@type": "Organization",
    "name": "GeoMatch",
    "logo": {
      "@type": "ImageObject",
      "url": image_url("logo-geomatch.svg")
    }
  }
}.to_json %>
</script>

<article class="blog-post-container">
  <div class="post-header">
    <div class="breadcrumb">
      <%= link_to "Blog", blog_path %> /
      <%= link_to @blog_post.blog_category.name, blog_category_path(@blog_post.blog_category.slug) %> /
      <span><%= @blog_post.title %></span>
    </div>

    <h1 class="post-title"><%= @blog_post.title %></h1>

    <div class="post-meta">
      <span class="post-author">Por <%= @blog_post.user.display_name %></span>
      <span class="post-date"><%= l(@blog_post.published_at, format: :long) %></span>
      <span class="post-reading-time">~<%= estimate_reading_time(@blog_post.content) %> min de leitura</span>
    </div>
  </div>

  <% if @blog_post.featured_image.present? %>
    <div class="post-featured-image">
      <%= image_tag @blog_post.featured_image, alt: @blog_post.title %>
    </div>
  <% end %>

  <div class="post-body prose">
    <%= simple_format(@blog_post.content) %>
  </div>

  <div class="post-footer">
    <div class="post-category-badge">
      <%= link_to @blog_post.blog_category.name, blog_category_path(@blog_post.blog_category.slug), class: "category-link" %>
    </div>

    <div class="post-navigation">
      <% prev_post = BlogPost.published.where("published_at < ?", @blog_post.published_at).first %>
      <% next_post = BlogPost.published.where("published_at > ?", @blog_post.published_at).last %>

      <% if prev_post.present? %>
        <%= link_to "← Artigo anterior", blog_post_path(prev_post), class: "nav-link prev" %>
      <% end %>

      <% if next_post.present? %>
        <%= link_to "Próximo artigo →", blog_post_path(next_post), class: "nav-link next" %>
      <% end %>
    </div>
  </div>
</article>

<style>
  .blog-post-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .breadcrumb {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 30px;
  }

  .breadcrumb a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .post-title {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 20px;
    color: var(--color-text);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 30px;
  }

  .post-featured-image {
    width: 100%;
    height: 400px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .post-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
    margin-bottom: 50px;
  }

  .post-body h2 {
    font-size: 1.8rem;
    margin-top: 30px;
    margin-bottom: 15px;
    color: var(--color-text);
  }

  .post-body h3 {
    font-size: 1.4rem;
    margin-top: 20px;
    margin-bottom: 10px;
    color: var(--color-text);
  }

  .post-body p {
    margin-bottom: 15px;
  }

  .post-body ul,
  .post-body ol {
    margin-left: 20px;
    margin-bottom: 15px;
  }

  .post-body li {
    margin-bottom: 8px;
  }

  .post-footer {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }

  .post-category-badge {
    display: inline-block;
  }

  .category-link {
    background: var(--color-primary);
    color: #000;
    padding: 8px 20px;
    border-radius: 20px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
  }

  .category-link:hover {
    opacity: 0.9;
  }

  .post-navigation {
    display: flex;
    gap: 20px;
    justify-content: space-between;
  }

  .nav-link {
    flex: 1;
    padding: 15px 20px;
    border-radius: 8px;
    background: var(--color-section-light);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    transition: background 0.2s;
  }

  .nav-link:hover {
    background: var(--color-primary);
    color: #000;
  }

  .nav-link.next {
    text-align: right;
  }

  @media (max-width: 600px) {
    .post-title {
      font-size: 1.8rem;
    }

    .post-body {
      font-size: 1rem;
    }

    .post-featured-image {
      height: 250px;
    }

    .post-navigation {
      flex-direction: column;
    }

    .nav-link.next {
      text-align: left;
    }
  }
</style>

<% content_for :head do %>
  <%= simple_format(@blog_post.content) %>
<% end %>
