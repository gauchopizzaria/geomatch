<%# Coração do card de "Explorar cidades". A curtida fica na galeria: o LikesController
    responde por Turbo Stream (source=gallery) trocando este bloco pelo coração cheio e
    mostrando "Curtida enviada!" — sem recarregar nem perder a rolagem. Se precisar
    recarregar (navegador sem Turbo), return_to traz de volta para esta mesma busca.
    Locals: user, liked (já curtiu), return_to (caminho da galeria com os filtros) %>
<div id="gallery-like-<%= user.id %>" class="card-action-slot">
  <% heart = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>'.html_safe %>
  <% if liked %>
    <button type="button" class="card-action-btn card-action-fav is-liked" disabled
            title="Você já curtiu <%= user.display_name %>" aria-label="Você já curtiu <%= user.display_name %>"><%= heart %></button>
  <% else %>
    <%= button_to likes_path(user_id: user.id),
          method: :post,
          class: "card-action-btn card-action-fav",
          form: { class: "card-action-form" },
          params: { source: "gallery", return_to: local_assigns[:return_to] },
          title: "Curtir #{user.display_name}",
          aria: { label: "Curtir #{user.display_name}" } do %>
      <%= heart %>
    <% end %>
  <% end %>
</div>
