<% if favorite_id.present? %>
  <%= button_to favorite_path(favorite_id),
        method: :delete,
        class: "card-action-btn card-action-star card-action-star--active",
        form: { class: "card-action-form" },
        title: "Remover dos favoritos",
        aria: { label: "Remover dos favoritos" } do %>
    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  <% end %>
<% else %>
  <%= button_to favorites_path(favorited_user_id: user.id),
        method: :post,
        class: "card-action-btn card-action-star",
        form: { class: "card-action-form" },
        title: "Salvar nos favoritos",
        aria: { label: "Salvar nos favoritos" } do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>
  <% end %>
<% end %>
