<aside class="sidebar">
  <nav class="sidebar-nav">
    <% if user_signed_in? %>
      <!-- Link para Lead/Swipe (Início) -->
      <%= link_to lead_path, class: "nav-item #{'active' if current_page?(lead_path)}" do %>
        <i class="fas fa-fire"></i>
        <span class="nav-text">Início</span>
      <% end %>

      <!-- Link para Descobrir/Explorar -->
      <%= link_to discover_path, class: "nav-item #{'active' if current_page?(discover_path)}" do %>
        <i class="fas fa-compass"></i>
        <span class="nav-text">Explorar</span>
      <% end %>

      <!-- Link para Matches/Curtidas -->
      <%= link_to matches_path, class: "nav-item #{'active' if current_page?(matches_path)}" do %>
        <i class="fas fa-comment"></i>
        <span class="nav-text">Chat</span>
      <% end %>

      <!-- Link para Chat -->
      <%= link_to notifications_path, class: "nav-item notification-icon #{'active' if current_page?(notifications_path)}" do %>
         <i class="fas fa-heart"></i>
        <span class="nav-text">Curtidas</span>
        <span id="unread-notifications-count" class="badge <%= 'hidden' if current_user.notifications.unread.count == 0 %>">
          <%= current_user.notifications.unread.count %>
        </span>
      <% end %>

      <!-- Link para Meu Perfil -->
      <%= link_to edit_profile_path, class: "nav-item #{'active' if current_page?(edit_profile_path)}" do %>
        <i class="fas fa-user"></i>
        <span class="nav-text">Perfil</span>
      <% end %>

      <!-- Botão de Alternância de Tema (Modo Escuro/Claro) -->
      <button id="theme-toggle" class="nav-item theme-toggle-btn" title="Alternar Modo Escuro/Claro">
        <i class="fas fa-moon"></i> 
        <span class="nav-text">Tema</span>
      </button>
    <% end %>
  </nav>
</aside>
