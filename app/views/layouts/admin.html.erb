<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GeoMatch · Admin</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    ::-webkit-scrollbar{width:5px;height:5px}
    ::-webkit-scrollbar-track{background:#0f172a}
    ::-webkit-scrollbar-thumb{background:#334155;border-radius:4px}
    #toast-container{position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:999999;display:flex;flex-direction:column;align-items:center;gap:10px;pointer-events:none;width:100%;max-width:380px;padding:0 16px}
    .toast{pointer-events:all;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px;border-radius:14px;font-size:.88rem;font-weight:500;box-shadow:0 8px 32px rgba(0,0,0,.6);backdrop-filter:blur(12px);animation:toast-in .35s cubic-bezier(.34,1.56,.64,1) both;min-width:260px;max-width:380px;width:100%}
    .toast--notice{background:rgba(15,23,42,.96);border:1px solid rgba(245,158,11,.45);color:#f59e0b}
    .toast--alert{background:rgba(15,23,42,.96);border:1px solid rgba(239,68,68,.4);color:#f87171}
    .toast--hiding{animation:toast-out .3s ease-in both}
    .toast__message{flex:1;line-height:1.4}
    .toast__close{background:none;border:none;cursor:pointer;font-size:.85rem;padding:2px 4px;border-radius:4px;color:inherit;opacity:.65;transition:opacity .15s}
    .toast__close:hover{opacity:1}
    @keyframes toast-in{from{opacity:0;transform:translateY(-16px) scale(.95)}to{opacity:1;transform:translateY(0) scale(1)}}
    @keyframes toast-out{from{opacity:1;transform:translateY(0) scale(1)}to{opacity:0;transform:translateY(-12px) scale(.95)}}
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex" style="font-family:system-ui,-apple-system,sans-serif;">

  <div id="toast-container">
    <%= render 'shared/flash' %>
  </div>

  <!-- ── Sidebar — cópia fiel da sidebar do SPA (public/admin/index.html) ── -->
  <aside class="w-60 flex-shrink-0 bg-slate-900 border-r border-slate-800 flex flex-col fixed top-0 left-0 h-full z-20">

    <div class="p-5 border-b border-slate-800 flex items-center gap-3">
      <div class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-900 font-black text-sm flex-shrink-0" style="background:linear-gradient(135deg,#f59e0b,#d97706)">G</div>
      <div><div class="font-bold text-sm">GeoMatch</div><div class="text-xs font-semibold" style="color:#f59e0b">Admin Panel</div></div>
    </div>

    <nav class="flex-1 p-3 space-y-0.5 overflow-y-auto">

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" stroke-width="2"/><rect x="14" y="3" width="7" height="7" rx="1" stroke-width="2"/><rect x="3" y="14" width="7" height="7" rx="1" stroke-width="2"/><rect x="14" y="14" width="7" height="7" rx="1" stroke-width="2"/></svg>
        Visão Geral
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
        Mapa ao Vivo
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Analytics
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        Usuários
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        Denúncias
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        Performance
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
        Insights BI
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Engajamento
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
        Inteligência Política
        <span class="ml-auto text-xs font-bold px-1.5 py-px rounded-full text-slate-900" style="background:#f59e0b;font-size:9px">BI</span>
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Planos de Assinatura
        <span class="ml-auto text-xs font-bold px-1.5 py-px rounded-full text-slate-900" style="background:#22c55e;font-size:9px">SaaS</span>
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        Moderação de Fotos
      </a>

      <a href="/admin/index.html" data-turbo="false" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/60 transition-colors text-left">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
        Histórico de Ações
      </a>

      <%# ── item ativo ── %>
      <a href="/admin/settings" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-white bg-slate-800 text-left">
        <svg class="w-4 h-4 flex-shrink-0" style="color:#f59e0b" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 10v2m0-2a2 2 0 100-4m0 4a2 2 0 110-4m0-4V4"/>
        </svg>
        Configurações valores avulso
      </a>

    </nav>

    <div class="p-3 border-t border-slate-800">
      <div class="flex items-center gap-3 px-2">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-slate-900 font-bold text-xs flex-shrink-0" style="background:#f59e0b">
          <%= current_user.try(:name)&.first&.upcase || current_user.email[0].upcase %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-xs font-semibold text-white truncate">
            <%= current_user.try(:name) || current_user.email %>
          </div>
          <div class="text-xs text-slate-500">Administrador</div>
        </div>
        <%= link_to logout_path, data: { turbo_method: :delete }, title: "Sair",
              class: "text-slate-500 hover:text-red-400 transition-colors p-1" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        <% end %>
      </div>
    </div>
  </aside>

  <!-- ── Main ─────────────────────────────────────────── -->
  <main style="margin-left:240px;min-height:100vh;" class="flex-1 flex flex-col">

    <div class="sticky top-0 z-10 bg-slate-950/95 backdrop-blur border-b border-slate-800 px-7 py-3 flex items-center justify-between">
      <div>
        <h1 class="font-bold text-base">
          <%= content_for?(:page_title) ? yield(:page_title) : 'Admin' %>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">GeoMatch · Painel Administrativo</p>
      </div>
    </div>

    <div class="p-7 space-y-6 flex-1">
      <%= yield %>
    </div>

  </main>

  <%= javascript_include_tag "application", type: "module" %>
</body>
</html>
