<!-- FAQ Schema para SEO -->
<script type="application/ld+json">
<%= {
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Como excluir minha conta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Acesse seu perfil → Configurações → Excluir conta. Se precisar de ajuda, envie um e-mail com o assunto 'Excluir conta'."
      }
    },
    {
      "@type": "Question",
      "name": "Como cancelar minha assinatura?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Cancele diretamente pela App Store (iOS) ou pelo app em Perfil → Assinatura. Para reembolsos, entre em contato pelo e-mail acima."
      }
    },
    {
      "@type": "Question",
      "name": "Como reportar um usuário?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No perfil do usuário, toque em 'Reportar'. Nossa equipe de moderação analisa todos os relatos em até 24 horas."
      }
    },
    {
      "@type": "Question",
      "name": "Problemas com notificações?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verifique se as notificações estão habilitadas em Ajustes → GeoMatch → Notificações no seu dispositivo."
      }
    }
  ]
}.to_json %>
</script>

<div class="support-page">
  <div class="support-container">
    <div class="support-logo">
      <h1 class="support-brand">GeoMatch</h1>
    </div>

    <div class="support-card">
      <h2>Central de Suporte</h2>
      <p class="support-tagline">Precisa de ajuda com o GeoMatch? Estamos aqui para você.</p>

      <div class="support-section">
        <h3>Fale Conosco</h3>
        <p>Nossa equipe responde em até 48 horas úteis.</p>
        <a href="mailto:suporte@geomatchbr.com" class="support-email-btn">
          ✉ suporte@geomatchbr.com
        </a>
      </div>

      <div class="support-section">
        <h3>Perguntas Frequentes</h3>
        <div class="faq-item">
          <strong>Como excluir minha conta?</strong>
          <p>Acesse seu perfil → Configurações → Excluir conta. Se precisar de ajuda, envie um e-mail com o assunto "Excluir conta".</p>
        </div>
        <div class="faq-item">
          <strong>Como cancelar minha assinatura?</strong>
          <p>Cancele diretamente pela App Store (iOS) ou pelo app em Perfil → Assinatura. Para reembolsos, entre em contato pelo e-mail acima.</p>
        </div>
        <div class="faq-item">
          <strong>Como reportar um usuário?</strong>
          <p>No perfil do usuário, toque em "Reportar". Nossa equipe de moderação analisa todos os relatos em até 24 horas.</p>
        </div>
        <div class="faq-item">
          <strong>Problemas com notificações?</strong>
          <p>Verifique se as notificações estão habilitadas em Ajustes → GeoMatch → Notificações no seu dispositivo.</p>
        </div>
      </div>

      <div class="support-section support-footer-note">
        <p>Ao entrar em contato, informe seu nome de usuário e descreva o problema com o máximo de detalhes possível para agilizarmos o atendimento.</p>
      </div>
    </div>
  </div>
</div>

