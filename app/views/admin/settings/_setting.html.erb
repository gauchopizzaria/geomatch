<%= turbo_frame_tag "setting_#{item[:setting].id}" do %>
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex items-center justify-between gap-4 transition-all">

    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">
        <%= item[:label] %>
      </p>
      <p class="text-slate-400 text-sm leading-snug">
        <%= item[:description] %>
      </p>
    </div>

    <div class="flex items-center gap-3 flex-shrink-0">
      <span class="font-bold text-xl tabular-nums" style="color:#f59e0b">
        <% if item[:type] == :price %>
          R$ <%= format('%.2f', item[:setting].value / 100.0).tr('.', ',') %>
        <% else %>
          <%= item[:setting].value %>
        <% end %>
      </span>

      <%= link_to edit_admin_setting_path(item[:setting]),
            class: "px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700" do %>
        <svg class="w-3 h-3 inline-block mr-1 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
        </svg>
        Editar
      <% end %>
    </div>

  </div>
<% end %>
