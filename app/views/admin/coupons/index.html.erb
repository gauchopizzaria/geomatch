<% content_for :page_title, "Cupons" %>

<div class="max-w-6xl">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-lg font-bold text-white">Cupons</h2>
      <p class="text-sm text-slate-500 mt-0.5">Gerencie os cupons de acesso premium do GeoMatch.</p>
    </div>
    <%= link_to 'Novo Cupom', new_admin_coupon_path,
          class: "px-4 py-2 rounded-xl text-sm font-bold text-slate-900 transition-opacity hover:opacity-90",
          style: "background:linear-gradient(135deg,#f59e0b,#d97706)" %>
  </div>

  <% if @coupons.any? %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-800 text-left text-xs text-slate-500 uppercase tracking-wide">
            <th class="px-4 py-3 font-semibold">Código</th>
            <th class="px-4 py-3 font-semibold">Descrição</th>
            <th class="px-4 py-3 font-semibold">Tipo</th>
            <th class="px-4 py-3 font-semibold">Duração</th>
            <th class="px-4 py-3 font-semibold">Planos</th>
            <th class="px-4 py-3 font-semibold">Usos</th>
            <th class="px-4 py-3 font-semibold">Limite</th>
            <th class="px-4 py-3 font-semibold">Expira em</th>
            <th class="px-4 py-3 font-semibold">Ativo</th>
            <th class="px-4 py-3 font-semibold text-right">Ações</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/70">
          <% @coupons.each do |coupon| %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="px-4 py-3 font-bold text-amber-500"><%= coupon.code %></td>
              <td class="px-4 py-3 text-slate-300 max-w-[220px] truncate" title="<%= coupon.description %>"><%= coupon.description.presence || "—" %></td>
              <td class="px-4 py-3 text-slate-400"><%= coupon.discount_type %></td>
              <td class="px-4 py-3 text-slate-300"><%= coupon.duration_days ? "#{coupon.duration_days} dias" : "—" %></td>
              <td class="px-4 py-3 text-slate-300"><%= coupon.plan_codes.join(', ').presence || "—" %></td>
              <td class="px-4 py-3 text-slate-300"><%= coupon.used_count %></td>
              <td class="px-4 py-3 text-slate-300"><%= coupon.usage_limit.to_i.zero? ? "Ilimitado" : coupon.usage_limit %></td>
              <td class="px-4 py-3 text-slate-300"><%= coupon.expires_at&.strftime('%d/%m/%Y %H:%M') || "Nunca" %></td>
              <td class="px-4 py-3">
                <% if coupon.available? %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold text-emerald-950 bg-emerald-400">Ativo</span>
                <% elsif coupon.active? %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold text-amber-950 bg-amber-400">Esgotado/Expirado</span>
                <% else %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold text-slate-300 bg-slate-700">Inativo</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to 'Ver', admin_coupon_path(coupon),
                        class: "px-2.5 py-1 rounded-lg text-xs font-semibold text-slate-300 border border-slate-700 hover:bg-slate-800 transition-colors" %>
                  <%= link_to 'Editar', edit_admin_coupon_path(coupon),
                        class: "px-2.5 py-1 rounded-lg text-xs font-semibold text-amber-500 border border-amber-500/40 hover:bg-amber-500/10 transition-colors" %>
                  <%= button_to 'Excluir', admin_coupon_path(coupon), method: :delete,
                        data: { turbo_confirm: "Excluir o cupom #{coupon.code}? Os registros de uso também serão removidos." },
                        class: "px-2.5 py-1 rounded-lg text-xs font-semibold text-red-400 border border-red-500/40 hover:bg-red-500/10 transition-colors cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-10 text-center">
      <p class="text-slate-500 text-sm mb-4">Nenhum cupom criado ainda.</p>
      <%= link_to 'Criar o primeiro cupom', new_admin_coupon_path,
            class: "inline-block px-4 py-2 rounded-xl text-sm font-bold text-slate-900",
            style: "background:linear-gradient(135deg,#f59e0b,#d97706)" %>
    </div>
  <% end %>

</div>
