FROM ruby:3.2

WORKDIR /app

ENV RAILS_MAX_THREADS=3

COPY . .

RUN bundle install

# Garante permissão de execução e remove artefatos Windows (CRLF + ruby.exe)
RUN chmod +x bin/* && \
    sed -i "s/\r$//g" bin/* && \
    sed -i 's/ruby\.exe$/ruby/' bin/*

# Permissão explícita + diagnóstico: confirma no log do build que o arquivo existe
RUN chmod +x bin/jobs && ls -la bin/jobs

CMD ["bundle", "exec", "ruby", "./bin/jobs"]
